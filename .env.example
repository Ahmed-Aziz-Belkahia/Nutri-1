# =============================================
# NutriAI — Environment Configuration Template
# =============================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=
PGDATABASE=
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=

# AI Service API Keys
OPENAI_API_KEY=

# Google Cloud Vision API (for food image recognition)

# Nutritionix API (optional)

# Authentication Secrets (generate strong random values)
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=

# Google OAuth Configuration

# Email Configuration (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# SendGrid (alternative)

# Monitoring
MONITORING_API_KEY=

# Application URLs
APP_URL=https://app.nutriai.online

# CORS and Security Settings
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=https://app.nutriai.online
# Bundle identifier used as the Sign in with Apple audience
APPLE_BUNDLE_ID=online.nutriai.app
