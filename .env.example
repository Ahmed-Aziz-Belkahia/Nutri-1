# =============================================
# NutriAI — Environment Configuration Template
# =============================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=
PGDATABASE=
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=

# AI Service API Keys
OPENAI_API_KEY=

# Google Cloud Vision API (for food image recognition)
GOOGLE_APPLICATION_CREDENTIALS=credentials/vision-credentials.json

# Nutritionix API (optional)
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# Authentication Secrets (generate strong random values)
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email Configuration (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# SendGrid (alternative)
SENDGRID_API_KEY=

# Monitoring
MONITORING_API_KEY=

# Application URLs
APP_URL=https://app.nutriai.online

# CORS and Security Settings
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,http://localhost:5173
