                              </div>                  <div className="grid grid-cols-3 gap-3 mt-4">

                            </>                    {/* Latest Photo */}

                          ) : (                    <div 

                            <div className="w-full h-full flex flex-col items-center justify-center text-gray-400">                      className="cursor-pointer"

                              <Camera className="w-8 h-8 mb-1" />                      onClick={() => {

                              <span className="text-xs">No photo</span>                        const latestPhoto = photos.find(p => p.type === 'latest');

                            </div>                        if (latestPhoto?.photoUrl) handlePhotoClick(latestPhoto.photoUrl);

                          )}                      }}

                        </div>                    >

                        <p className="text-xs text-center text-gray-600 mt-2 font-medium">Favorite</p>                      <div className="aspect-[3/4] bg-gray-100 rounded-lg overflow-hidden relative group">

                      </div>                        {photos.find(p => p.type === 'latest') ? (

                                                <>

                      {/* First Photo */}                            <img

                      <div                               src={photos.find(p => p.type === 'latest')?.photoUrl || ''}

                        className="cursor-pointer group"                              alt="Latest Photo"

                        onClick={() => {                              className="w-full h-full object-cover"

                          const firstUploadedPhoto = [...photos].sort((a, b) => a.id - b.id)[0];                              onError={(e) => {

                          if (firstUploadedPhoto?.photoUrl) handlePhotoClick(firstUploadedPhoto.photoUrl);                                console.error('Image failed to load:', e.currentTarget.src);

                        }}                                e.currentTarget.src = '/placeholder-progress.png';

                      >                              }}

                        <div                             />

                          className="aspect-[3/4] rounded-2xl overflow-hidden relative border border-white/30"                            <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">

                          style={{                              <Clock className="w-6 h-6 text-white" />

                            backgroundColor: 'rgba(255, 255, 255, 0.3)',                            </div>

                            backdropFilter: 'blur(10px)'                          </>

                          }}                        ) : (

                        >                          <div className="w-full h-full flex items-center justify-center">

                          {photos.length > 0 ? (                            <Camera className="w-8 h-8 text-gray-400" />

                            <>                          </div>

                              <img                        )}

                                src={[...photos].sort((a, b) => a.id - b.id)[0]?.photoUrl || ''}                      </div>

                                alt="First Photo"                      <p className="text-xs text-center text-gray-600 mt-1">Latest Photo</p>

                                className="w-full h-full object-cover"                    </div>

                              />                    

                              <div className="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-center pb-3">                    {/* Favorite Photo */}

                                <Star className="w-5 h-5 text-white" />                    <div 

                              </div>                      className="cursor-pointer"

                            </>                      onClick={() => {

                          ) : (                        const favoritePhoto = photos.find(p => p.type === 'favorite');

                            <div className="w-full h-full flex flex-col items-center justify-center text-gray-400">                        if (favoritePhoto?.photoUrl) handlePhotoClick(favoritePhoto.photoUrl);

                              <Camera className="w-8 h-8 mb-1" />                      }}

                              <span className="text-xs">No photo</span>                    >

                            </div>                      <div className="aspect-[3/4] bg-gray-100 rounded-lg overflow-hidden relative group">

                          )}                        {photos.find(p => p.type === 'favorite') ? (

                        </div>                          <>

                        <p className="text-xs text-center text-gray-600 mt-2 font-medium">First</p>                            <img

                      </div>                              src={photos.find(p => p.type === 'favorite')?.photoUrl || ''}

                    </div>                              alt="Favorite Photo"

                                                  className="w-full h-full object-cover"

                    <Button                              onError={(e) => {

                      className="w-full mt-4 bg-white/60 backdrop-blur-sm border border-white/30 text-gray-700 hover:bg-white/80 h-12 rounded-2xl font-medium"                                console.error('Image failed to load:', e.currentTarget.src);

                      onClick={() => setIsGalleryOpen(true)}                                e.currentTarget.src = '/placeholder-progress.png';

                    >                              }}

                      <ImageIcon className="w-5 h-5 mr-2" />                            />

                      View All Photos ({photos.length})                            <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">

                    </Button>                              <Heart className="w-6 h-6 text-white" />

                  </div>                            </div>

                </div>                          </>

              </div>                        ) : (

            )}                          <div className="w-full h-full flex items-center justify-center">

          </motion.div>                            <Camera className="w-8 h-8 text-gray-400" />

        </AnimatePresence>                          </div>

                        )}

        {/* Navigation Arrows */}                      </div>

        <div className="flex justify-between items-center pt-4">                      <p className="text-xs text-center text-gray-600 mt-1">Favorite Photo</p>

          <Button                    </div>

            className={`w-12 h-12 rounded-full flex items-center justify-center transition-all ${                    

              currentSection === 0                    {/* First Photo */}

                ? 'bg-gray-200 text-gray-400 cursor-not-allowed'                    <div 

                : 'bg-gradient-to-r from-[#26A8FF] to-blue-500 text-white shadow-lg shadow-blue-500/30'                      className="cursor-pointer"

            }`}                      onClick={() => {

            onClick={() => setCurrentSection(prev => Math.max(0, prev - 1))}                        const firstUploadedPhoto = [...photos].sort((a, b) => a.id - b.id)[0];

            disabled={currentSection === 0}                        if (firstUploadedPhoto?.photoUrl) handlePhotoClick(firstUploadedPhoto.photoUrl);

          >                      }}

            <ChevronLeft className="w-6 h-6" />                    >

          </Button>                      <div className="aspect-[3/4] bg-gray-100 rounded-lg overflow-hidden relative group">

                                  {photos.length > 0 ? (

          <div className="flex gap-2">                          <>

            {progressSections.map((_, index) => (                            <img

              <div                              src={[...photos].sort((a, b) => a.id - b.id)[0]?.photoUrl || ''}

                key={index}                              alt="First Photo"

                className={`rounded-full transition-all ${                              className="w-full h-full object-cover"

                  index === currentSection ? 'w-8 h-2 bg-[#26A8FF]' : 'w-2 h-2 bg-gray-300'                              onError={(e) => {

                }`}                                console.error('Image failed to load:', e.currentTarget.src);

              />                                e.currentTarget.src = '/placeholder-progress.png';

            ))}                              }}

          </div>                            />

                                      <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">

          <Button                              <Star className="w-6 h-6 text-white" />

            className={`w-12 h-12 rounded-full flex items-center justify-center transition-all ${                            </div>

              currentSection === progressSections.length - 1                          </>

                ? 'bg-gray-200 text-gray-400 cursor-not-allowed'                        ) : (

                : 'bg-gradient-to-r from-[#26A8FF] to-blue-500 text-white shadow-lg shadow-blue-500/30'                          <div className="w-full h-full flex items-center justify-center">

            }`}                            <Camera className="w-8 h-8 text-gray-400" />

            onClick={() => setCurrentSection(prev => Math.min(progressSections.length - 1, prev + 1))}                          </div>

            disabled={currentSection === progressSections.length - 1}                        )}

          >                      </div>

            <ChevronRight className="w-6 h-6" />                      <p className="text-xs text-center text-gray-600 mt-1">First Photo</p>

          </Button>                    </div>

        </div>                  </div>

      </div>                  

                  <Button

      {/* Photo Gallery Dialog */}                    variant="outline"

      <Dialog open={isGalleryOpen} onOpenChange={setIsGalleryOpen}>                    className="w-full mt-4 border-emerald-500 text-emerald-600 hover:bg-emerald-50"

        <DialogContent className="sm:max-w-[700px] max-h-[90vh] overflow-y-auto rounded-3xl">                    onClick={() => setIsGalleryOpen(true)}

          <DialogHeader>                  >

            <DialogTitle className="text-xl font-bold">Progress Photo Gallery</DialogTitle>                    View All Photos

            <DialogDescription>                  </Button>

              View all your progress photos                </div>

            </DialogDescription>              </Card>

          </DialogHeader>            </div>

                    )}

          <div className="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-4">

            {photos.length > 0 ? photos.map(photo => (          {/* Streaks & Achievements section removed */}

              <div         </motion.div>

                key={photo.id}         

                className="cursor-pointer relative aspect-[3/4] bg-gray-100 rounded-2xl overflow-hidden group border border-gray-200"        {/* Navigation buttons */}

                onClick={() => {        <div className="flex justify-between">

                  setSelectedPhotoUrl(photo.photoUrl);          <Button

                  setIsGalleryOpen(false);            variant="outline"

                }}            className="w-12 h-12 rounded-full flex items-center justify-center border-emerald-500 text-emerald-700 hover:bg-emerald-50"

              >            onClick={() => setCurrentSection(prev => Math.max(0, prev - 1))}

                <img             disabled={currentSection === 0}

                  src={photo.photoUrl || ''}           >

                  alt={photo.caption || 'Progress photo'}             <ChevronLeft className="w-5 h-5" />

                  className="w-full h-full object-cover"          </Button>

                />          <Button

                <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">            variant="outline"

                  <button className="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center text-white hover:bg-white/30">            className="w-12 h-12 rounded-full flex items-center justify-center border-emerald-500 text-emerald-700 hover:bg-emerald-50"

                    <ImageIcon className="w-6 h-6" />            onClick={() => setCurrentSection(prev => Math.min(progressSections.length - 1, prev + 1))}

                  </button>            disabled={currentSection === progressSections.length - 1}

                </div>          >

                {photo.createdAt && (            <ChevronRight className="w-5 h-5" />

                  <div className="absolute bottom-2 left-2 right-2 bg-black/70 backdrop-blur-sm text-white text-xs p-2 rounded-xl">          </Button>

                    {new Date(photo.createdAt).toLocaleDateString()}        </div>

                  </div>      </div>

                )}

              </div>      {/* Photo Gallery Dialog */}

            )) : (      <Dialog open={isGalleryOpen} onOpenChange={setIsGalleryOpen}>

              <div className="col-span-3 py-12 text-center text-gray-500">        <DialogContent className="sm:max-w-[700px] max-h-[90vh] overflow-y-auto">

                <Camera className="w-16 h-16 mx-auto mb-3 text-gray-300" />          <DialogHeader>

                <p className="text-lg font-medium mb-2">No progress photos yet</p>            <DialogTitle>Progress Photo Gallery</DialogTitle>

                <p className="text-sm text-gray-400 mb-4">Start tracking your journey today</p>            <DialogDescription>

                <Button               View all your progress photos

                  className="bg-gradient-to-r from-[#26A8FF] to-blue-500 text-white shadow-lg shadow-blue-500/30"            </DialogDescription>

                  onClick={() => {          </DialogHeader>

                    setIsGalleryOpen(false);          

                    setIsCameraOpen(true);          <div className="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-4">

                  }}            {photos.length > 0 ? photos.map(photo => (

                >              <div 

                  <Camera className="w-4 h-4 mr-2" />                key={photo.id} 

                  Take Your First Photo                className="cursor-pointer relative aspect-[3/4] bg-gray-100 rounded-lg overflow-hidden group"

                </Button>                onClick={() => {

              </div>                  setSelectedPhotoUrl(photo.photoUrl);

            )}                  setIsGalleryOpen(false);

          </div>                }}

                        >

          <DialogFooter className="flex sm:justify-between gap-2 mt-4">                <img 

            <Button                  src={photo.photoUrl || ''} 

              variant="outline"                  alt={photo.caption || 'Progress photo'} 

              className="rounded-2xl"                  className="w-full h-full object-cover"

              onClick={() => setIsGalleryOpen(false)}                  onError={(e) => {

            >                    console.error('Image failed to load:', e.currentTarget.src);

              Close                    e.currentTarget.src = '/placeholder-progress.png';

            </Button>                  }}

            <div className="flex gap-2">                />

              <Button                <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">

                className="bg-white/60 backdrop-blur-sm border border-white/30 text-gray-700 hover:bg-white/80 rounded-2xl"                  <button className="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center text-white hover:bg-white/40">

                onClick={() => {                    <Image className="w-5 h-5" />

                  setIsGalleryOpen(false);                  </button>

                  setIsCameraOpen(true);                </div>

                }}                {photo.createdAt && (

              >                  <div className="absolute bottom-2 left-2 right-2 bg-black/60 text-white text-xs p-1 rounded">

                <Camera className="h-4 w-4 mr-2" />                    {new Date(photo.createdAt).toLocaleDateString()}

                Take Photo                  </div>

              </Button>                )}

                            </div>

              <Button            )) : (

                className="bg-gradient-to-r from-[#26A8FF] to-blue-500 text-white hover:opacity-90 rounded-2xl shadow-lg shadow-blue-500/30"              <div className="col-span-3 py-8 text-center text-gray-500">

                onClick={() => {                <Camera className="w-12 h-12 mx-auto mb-2 text-gray-400" />

                  document.getElementById('photo-upload')?.click();                <p>No progress photos yet</p>

                }}                <Button 

              >                  className="mt-4 bg-pink-500 hover:bg-pink-600 text-white"

                <Upload className="h-4 w-4 mr-2" />                  onClick={() => {

                Upload                    setIsGalleryOpen(false);

              </Button>                    setIsCameraOpen(true);

            </div>                  }}

          </DialogFooter>                >

        </DialogContent>                  Take Your First Photo

      </Dialog>                </Button>

              </div>

      {/* Camera Dialog */}            )}

      {isCameraOpen && (          </div>

        <CameraCapture          

          onClose={() => setIsCameraOpen(false)}          <DialogFooter className="flex sm:justify-between gap-2 mt-4">

          onPhotoCapture={async (photoUrl) => {            <Button

            await handlePhotoCapture(photoUrl);              variant="outline"

            setIsCameraOpen(false);              onClick={() => setIsGalleryOpen(false)}

          }}            >

        />              Close

      )}            </Button>

                  <div className="flex gap-2">

      {/* Photo Viewer Dialog */}              <Button

      <Dialog open={!!selectedPhotoUrl} onOpenChange={(open) => !open && setSelectedPhotoUrl(null)}>                variant="outline"

        <DialogContent className="sm:max-w-[95vw] sm:max-h-[95vh] p-0 overflow-hidden bg-black rounded-3xl">                className="border-[#0CC5BA] text-[#0CC5BA] hover:bg-[#0CC5BA]/10"

          <div className="relative">                onClick={() => {

            <button                  setIsGalleryOpen(false);

              onClick={() => setSelectedPhotoUrl(null)}                  setIsCameraOpen(true);

              className="absolute top-4 right-4 z-10 bg-black/50 backdrop-blur-sm text-white p-3 rounded-full hover:bg-black/70"                }}

            >              >

              <X className="h-5 w-5" />                <Camera className="h-4 w-4 mr-2" />

            </button>                Take Photo

            {selectedPhotoUrl && (              </Button>

              <div className="flex items-center justify-center">              

                <img               <Button

                  src={selectedPhotoUrl || ''}                 className="bg-[#0CC5BA] hover:bg-[#0CC5BA]/90 text-white"

                  alt="Progress"                 onClick={() => {

                  className="w-full h-auto max-h-[90vh] object-contain"                  document.getElementById('photo-upload')?.click();

                />                }}

              </div>              >

            )}                <Upload className="h-4 w-4 mr-2" />

            <div className="absolute bottom-0 inset-x-0 p-6 flex justify-center gap-3 bg-gradient-to-t from-black/90 via-black/50 to-transparent">                Upload

              <button className="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center text-white hover:bg-white/30 transition-all">              </Button>

                <Heart className="w-5 h-5" />            </div>

              </button>          </DialogFooter>

              <button className="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center text-white hover:bg-white/30 transition-all">        </DialogContent>

                <Share className="w-5 h-5" />      </Dialog>

              </button>

              <button className="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center text-white hover:bg-white/30 transition-all">

                <Download className="w-5 h-5" />      {/* Camera Dialog */}

              </button>      {isCameraOpen && (

              <button         <CameraCapture

                onClick={handleDeletePhotoClick}          onClose={() => setIsCameraOpen(false)}

                disabled={isDeletingPhoto}          onPhotoCapture={async (photoUrl) => {

                className="w-12 h-12 bg-red-500/80 backdrop-blur-sm rounded-full flex items-center justify-center text-white hover:bg-red-600 transition-all"            await handlePhotoCapture(photoUrl);

              >            setIsCameraOpen(false);

                <Trash2 className="w-5 h-5" />          }}

              </button>        />

            </div>      )}

          </div>      

        </DialogContent>      {/* Photo Viewer Dialog */}

      </Dialog>      <Dialog open={!!selectedPhotoUrl} onOpenChange={(open) => !open && setSelectedPhotoUrl(null)}>

        <DialogContent className="sm:max-w-[95vw] sm:max-h-[95vh] p-0 overflow-hidden bg-black">

      {/* Delete Confirmation Dialog */}          <div className="relative">

      <AlertDialog open={isDeleteDialogOpen} onOpenChange={setIsDeleteDialogOpen}>            <button

        <AlertDialogContent className="rounded-3xl">              onClick={() => setSelectedPhotoUrl(null)}

          <AlertDialogHeader>              className="absolute top-4 right-4 z-10 bg-black/50 text-white p-2 rounded-full"

            <AlertDialogTitle>Delete Progress Photo</AlertDialogTitle>            >

            <AlertDialogDescription>              <X className="h-5 w-5" />

              Are you sure you want to delete this progress photo? This action cannot be undone.            </button>

            </AlertDialogDescription>            {selectedPhotoUrl && (

          </AlertDialogHeader>              <div className="flex items-center justify-center">

          <AlertDialogFooter>                <img 

            <AlertDialogCancel className="rounded-2xl" onClick={() => setIsDeleteDialogOpen(false)}>Cancel</AlertDialogCancel>                  src={selectedPhotoUrl || ''} 

            <AlertDialogAction                  alt="Progress" 

              onClick={handleDeletePhoto}                  className="w-full h-auto max-h-[90vh] object-contain"

              disabled={isDeletingPhoto}                  onError={(e) => {

              className="bg-red-500 hover:bg-red-600 focus:ring-red-500 rounded-2xl"                    console.error('Image failed to load in dialog:', e.currentTarget.src);

            >                    e.currentTarget.src = '/placeholder-progress.png';

              {isDeletingPhoto ? "Deleting..." : "Delete"}                  }}

            </AlertDialogAction>                />

          </AlertDialogFooter>              </div>

        </AlertDialogContent>            )}

      </AlertDialog>            <div className="absolute bottom-0 inset-x-0 p-4 flex justify-center gap-4 bg-gradient-to-t from-black/70 to-transparent">

    </BaseLayout>              <button className="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center text-white hover:bg-white/40">

  );                <Heart className="w-5 h-5" />

}              </button>

              <button className="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center text-white hover:bg-white/40">
                <Share className="w-5 h-5" />
              </button>
              <button className="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center text-white hover:bg-white/40">
                <Download className="w-5 h-5" />
              </button>
              <button 
                onClick={handleDeletePhotoClick}
                disabled={isDeletingPhoto}
                className="w-10 h-10 bg-red-500/80 rounded-full flex items-center justify-center text-white hover:bg-red-600"
              >
                <Trash2 className="w-5 h-5" />
              </button>
            </div>
          </div>
        </DialogContent>
      </Dialog>

      {/* Delete Confirmation Dialog */}
      <AlertDialog open={isDeleteDialogOpen} onOpenChange={setIsDeleteDialogOpen}>
        <AlertDialogContent className="sm:max-w-[425px]">
          <AlertDialogHeader>
            <AlertDialogTitle>Delete Progress Photo</AlertDialogTitle>
            <AlertDialogDescription>
              Are you sure you want to delete this progress photo? This action cannot be undone.
            </AlertDialogDescription>
          </AlertDialogHeader>
          <AlertDialogFooter>
            <AlertDialogCancel onClick={() => setIsDeleteDialogOpen(false)}>Cancel</AlertDialogCancel>
            <AlertDialogAction
              onClick={handleDeletePhoto}
              disabled={isDeletingPhoto}
              className="bg-red-500 hover:bg-red-600 focus:ring-red-500"
            >
              {isDeletingPhoto ? "Deleting..." : "Delete"}
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>
      </div>
    </BaseLayout>
  );
}
