              className="text-center py-12"
            >
              <motion.div
                initial={{ scale: 0 }}
                animate={{ scale: 1 }}
                transition={{ type: "spring", stiffness: 200 }}
                className="text-5xl mb-4"
              >
                🍽️
              </motion.div>
              <motion.p
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                transition={{ delay: 0.2 }}
                className="text-lg text-gray-500"
              >
                No meals logged today.
              </motion.p>
            </motion.div>
          )}
        </motion.div>

        <motion.div variants={itemVariants} className="mt-12">
          <div className="flex items-center justify-between mb-5">
            <div className="flex items-center gap-3">
              <motion.div
                whileHover={{ scale: 1.05 }}
                whileTap={{ scale: 0.95 }}
                className="w-12 h-12 rounded-xl bg-gradient-to-r from-[#0CC5BA] to-blue-500 flex items-center justify-center shadow-md"
              >
                <CalendarDays className="w-6 h-6 text-white" strokeWidth={2.5} />
              </motion.div>
              <div>
                <h2 className="text-xl font-bold text-gray-800">
                  Today's Meal Plan
                </h2>
                <p className="text-xs font-medium text-gray-500">Personalized to meet your goals</p>
              </div>
            </div>
            <Link href="/meal-plan">
              <motion.div whileHover={{ scale: 1.05 }} whileTap={{ scale: 0.95 }}>
                <Button
                  size="sm"
                  className="text-white bg-gradient-to-r from-[#0CC5BA] to-blue-500 hover:shadow-lg transition-all duration-300 rounded-xl text-sm font-medium shadow-md"
                >
                  View Plan
                  <ChevronRight className="h-4 w-4 ml-1" />
                </Button>
              </motion.div>
            </Link>
          </div>
          <TodaysMealPlans selectedDate={selectedDate} />
        </motion.div>
      </motion.main>

      <Link href="/add-food">
        <motion.button
          whileHover={{ scale: 1.05 }}
          whileTap={{ scale: 0.95 }}
          className="fixed bottom-8 right-8 w-14 h-14 rounded-full bg-gradient-to-r from-[#0CC5BA] to-blue-500 text-white shadow-lg flex items-center justify-center"
        >
          <Plus className="w-6 h-6" />
        </motion.button>
      </Link>

    </div>
  );
}