                  {isToday(selectedDate) ? "Track your daily nutrition" : format(selectedDate, "EEEE's nutrition")}
                </span>
              </motion.div>
            </div>

            <DropdownMenu>
              <DropdownMenuTrigger asChild>
                <motion.div
