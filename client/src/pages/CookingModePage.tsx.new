import React, { useState, useEffect } from "react";
import { useQuery } from "@tanstack/react-query";
import { useLocation, useRoute, useParams } from "wouter";
import { motion } from "framer-motion";
import { Button } from "@/components/ui/button";
import { Progress } from "@/components/ui/progress";
import { 
  ChevronLeft, 
  ChevronRight, 
  X,
  Utensils,
  PlusCircle,
  ArrowRight,
  Check,
  Clock,
  Users,
  ShoppingBag,
  ChefHat,
  MinusCircle,
  Lightbulb,
  Plus,
  Minus,
  CakeSlice,
  Scale
} from "lucide-react";
import axios from "axios";
import { useToast } from "@/hooks/use-toast";
import { Card } from "@/components/ui/card";
import { Separator } from "@/components/ui/separator";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";

export default function CookingModePage() {
  const [_, params] = useRoute('/cooking/:recipeId');
  const recipeId = params?.recipeId;
  const [location, navigate] = useLocation();
  const [currentStep, setCurrentStep] = useState(0);
  const [showCompletedScreen, setShowCompletedScreen] = useState(false);
  const [servingSize, setServingSize] = useState(2);
  const [adjustedIngredients, setAdjustedIngredients] = useState<string[]>([]);
  const [showServingSelector, setShowServingSelector] = useState(true);
  const [showIngredientsPrep, setShowIngredientsPrep] = useState(false);
  const [cookingStarted, setCookingStarted] = useState(false);
  const { toast } = useToast();

  // Fetch recipe data
  const { data: recipe, isLoading, isError } = useQuery({
    queryKey: ["/api/recipes", recipeId],
    queryFn: async () => {
      if (!recipeId) {
        throw new Error('No recipe ID provided');
      }
      const response = await fetch(`/api/recipes/${recipeId}`);
      if (!response.ok) throw new Error('Failed to fetch recipe');
      return response.json();
    },
  });

  // Parse instructions from the recipe
  const instructionSteps = React.useMemo(() => {
    if (!recipe) return [];
    
    if (typeof recipe.instructions === 'string') {
      try {
        // Attempt to parse as JSON
        return JSON.parse(recipe.instructions);
      } catch (e) {
        // If not JSON, split by newlines
        return recipe.instructions.split(/\r?\n/).filter((step: string) => step.trim() !== '');
      }
    } else if (Array.isArray(recipe.instructions)) {
      return recipe.instructions;
    }
    
    return [];
  }, [recipe]);

  // Original serving count for reference
  const originalServingCount = 2; 

  // Adjust ingredients based on serving size
  useEffect(() => {
    if (recipe && recipe.ingredients && Array.isArray(recipe.ingredients)) {
      // Default serving size is usually 2-4 people, let's assume 2 as base
      const baseServingSize = 2;
      const ratio = servingSize / baseServingSize;
      
      // Function to adjust quantity in an ingredient string
      const adjustQuantity = (ingredient: string) => {
        // Match patterns like "1 cup", "1/2 teaspoon", "2 tablespoons", "3.5 grams"
        return ingredient.replace(/^([\d\/\.]+)(\s+)/, (match, quantity, space) => {
          // Convert fractions like 1/2 to decimal
          let numericValue: number;
          
          if (quantity.includes('/')) {
            const parts = quantity.split('/');
            numericValue = parseInt(parts[0]) / parseInt(parts[1]);
          } else {
            numericValue = parseFloat(quantity);
          }
          
          // Apply the serving size ratio
          const adjustedValue = numericValue * ratio;
          
          // Format the result
          let formattedValue: string;
          if (adjustedValue === Math.floor(adjustedValue)) {
            formattedValue = adjustedValue.toString();
          } else {
            // Round to 2 decimal places if needed
            const rounded = Math.round(adjustedValue * 100) / 100;
            formattedValue = rounded.toString();
          }
          
          return `${formattedValue}${space}`;
        });
      };
      
      const adjusted = recipe.ingredients.map(adjustQuantity);
      setAdjustedIngredients(adjusted);
    }
  }, [recipe, servingSize]);

  const totalSteps = instructionSteps.length;
  const progress = ((currentStep + 1) / totalSteps) * 100;
  
  // Function to handle serving size adjustments
  const incrementServingSize = () => {
    if (servingSize < 12) {
      setServingSize(servingSize + 1);
    }
  };
  
  const decrementServingSize = () => {
    if (servingSize > 1) {
      setServingSize(servingSize - 1);
    }
  };
  
  // Function to start the cooking process
  const startCooking = () => {
    setCookingStarted(true);
    setShowServingSelector(false);
    setShowIngredientsPrep(false);
  };
  
  // Function to proceed from serving selector to ingredients prep
  const proceedToIngredients = () => {
    setShowServingSelector(false);
    setShowIngredientsPrep(true);
  };

  // Lock scrolling on the page when cooking mode is active
  useEffect(() => {
    // Save original body styles
    const originalOverflow = document.body.style.overflow;
    const originalPosition = document.body.style.position;
    const originalHeight = document.body.style.height;
    const originalWidth = document.body.style.width;
    
    // Lock scrolling on the body element
    document.body.style.overflow = 'hidden';
    document.body.style.position = 'fixed';
    document.body.style.width = '100%';
    document.body.style.height = '100%';
    
    // Restore original styles when component unmounts
    return () => {
      document.body.style.overflow = originalOverflow;
      document.body.style.position = originalPosition;
      document.body.style.height = originalHeight;
      document.body.style.width = originalWidth;
    };
  }, []);

  const goToNextStep = () => {
    if (currentStep < totalSteps - 1) {
      setCurrentStep(currentStep + 1);
    } else {
      setShowCompletedScreen(true);
    }
  };

  const goToPrevStep = () => {
    if (currentStep > 0) {
      setCurrentStep(currentStep - 1);
    }
  };

  const handleLogFood = async () => {
    try {
      if (recipeId && recipe) {
        // Create a food log entry with the recipe data
        await axios.post('/api/food-logs', {
          name: recipe.name,
          calories: recipe.nutritionInfo?.calories || 0,
          protein: recipe.nutritionInfo?.protein || 0,
          carbs: recipe.nutritionInfo?.carbs || 0,
          fat: recipe.nutritionInfo?.fat || 0,
          date: new Date().toISOString().split('T')[0],
          image: recipe.imageUrl,
          // Include recipe reference in components
          components: [{
            name: recipe.name,
            calories: recipe.nutritionInfo?.calories || 0,
            protein: recipe.nutritionInfo?.protein || 0,
            carbs: recipe.nutritionInfo?.carbs || 0,
            fat: recipe.nutritionInfo?.fat || 0,
            details: {
              type: 'recipe',
              recipeId: recipe.id
            }
          }]
        });
        
        toast({
          title: "Food logged successfully!",
          description: `${recipe.name || 'Recipe'} has been added to your food log.`
        });
      }
      navigate(`/recipe/${recipeId}`);
    } catch (error) {
      console.error("Error logging food:", error);
      toast({
        title: "Error logging food",
        description: "Something went wrong. Please try again.",
        variant: "destructive"
      });
    }
  };

  const handleClose = () => {
    navigate(`/recipe/${recipeId}`);
  };

  if (isLoading) {
    return (
      <div className="fixed inset-0 bg-white flex items-center justify-center z-50">
        <div className="text-center">
          <div className="inline-block w-12 h-12 border-4 border-t-[#0CC5BA] border-solid border-gray-200 rounded-full animate-spin mb-4"></div>
          <p className="text-gray-600">Loading recipe...</p>
        </div>
      </div>
    );
  }

  if (isError || !recipe) {
    return (
      <div className="fixed inset-0 bg-white flex items-center justify-center z-50">
        <div className="text-center p-6 max-w-md">
          <div className="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <X className="h-8 w-8 text-red-500" />
          </div>
          <h2 className="text-xl font-semibold text-gray-800 mb-2">Error Loading Recipe</h2>
          <p className="text-gray-600 mb-6">We couldn't load the recipe. Please try again.</p>
          <Button 
            className="bg-[#0CC5BA] hover:bg-teal-600"
            onClick={() => navigate(`/recipe/${recipeId}`)}
          >
            Go Back to Recipe
          </Button>
        </div>
      </div>
    );
  }

  // Completion screen
  if (showCompletedScreen) {
    return (
      <div className="fixed inset-0 bg-white z-[9999] flex flex-col">
        <div className="flex justify-between items-center z-10 px-5 py-4 bg-white shadow-sm">
          <Button
            variant="ghost"
            size="icon"
            className="rounded-full text-gray-600 hover:bg-gray-100"
            onClick={handleClose}
          >
            <X className="h-5 w-5" />
          </Button>
          
          <div className="px-3 py-1.5 bg-teal-50 rounded-full text-xs font-medium text-teal-700 uppercase tracking-wide">
            Complete
          </div>
        </div>
        
        <div className="flex-1 flex flex-col items-center justify-center px-5">
          {/* Large success animation/icon */}
          <div className="mb-10">
            <div className="relative">
              <div className="absolute -inset-8 rounded-full bg-teal-500 opacity-10 blur-xl"></div>
              <div className="h-28 w-28 rounded-full bg-teal-50 border-2 border-teal-200 flex items-center justify-center relative shadow-md">
                <div className="absolute inset-1 rounded-full bg-teal-100 opacity-40 blur-md"></div>
                <Check className="h-14 w-14 text-teal-600" />
              </div>
            </div>
          </div>
          
          <div className="text-center mb-10">
            <h2 className="text-3xl font-bold text-gray-800 mb-3">
              Recipe Complete
            </h2>
            
            <p className="text-gray-600 max-w-xs mx-auto text-lg">
              You've successfully prepared <span className="font-semibold text-teal-600">{recipe.name || 'this recipe'}</span>
            </p>
          </div>
          
          <div className="w-full max-w-xs space-y-4 mb-10">
            <Button 
              className="w-full py-4 rounded-full font-medium bg-teal-500 text-white hover:bg-teal-600"
              onClick={handleLogFood}
            >
              <PlusCircle className="mr-2 h-5 w-5" />
              Log to Food Diary
            </Button>
            
            <Button 
              variant="outline" 
              className="w-full py-4 rounded-full font-medium border-gray-200 text-gray-700 hover:bg-gray-50"
              onClick={handleClose}
            >
              Back to Recipe
            </Button>
          </div>
          
          {/* Nutritional summary */}
          {recipe.nutritionInfo && (
            <div className="w-full max-w-xs">
              <div className="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
                <h3 className="uppercase text-xs tracking-wider text-gray-500 font-semibold mb-5 flex items-center">
                  <Check className="mr-2 h-4 w-4 text-teal-600" />
                  Nutrition per serving
                </h3>
                
                <div className="grid grid-cols-2 gap-5">
                  <div className="flex flex-col items-center">
                    <div className="text-2xl font-bold text-teal-600 mb-1">
                      {recipe.nutritionInfo.calories ? Math.round(recipe.nutritionInfo.calories / 2) : '—'}
                    </div>
                    <div className="text-xs text-gray-500 uppercase tracking-wider">calories</div>
                  </div>
                  <div className="flex flex-col items-center">
                    <div className="text-2xl font-bold text-teal-600 mb-1">
                      {recipe.nutritionInfo.protein ? Math.round(recipe.nutritionInfo.protein / 2) : '—'}g
                    </div>
                    <div className="text-xs text-gray-500 uppercase tracking-wider">protein</div>
                  </div>
                  <div className="flex flex-col items-center">
                    <div className="text-2xl font-bold text-teal-600 mb-1">
                      {recipe.nutritionInfo.carbs ? Math.round(recipe.nutritionInfo.carbs / 2) : '—'}g
                    </div>
                    <div className="text-xs text-gray-500 uppercase tracking-wider">carbs</div>
                  </div>
                  <div className="flex flex-col items-center">
                    <div className="text-2xl font-bold text-teal-600 mb-1">
                      {recipe.nutritionInfo.fat ? Math.round(recipe.nutritionInfo.fat / 2) : '—'}g
                    </div>
                    <div className="text-xs text-gray-500 uppercase tracking-wider">fat</div>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    );
  }

  // Serving size selector screen
  if (showServingSelector) {
    return (
      <div className="fixed inset-0 bg-white z-[9999] flex flex-col">
        {/* Header Bar */}
        <div className="flex justify-between items-center z-10 px-5 py-4 bg-white shadow-sm">
          <Button
            variant="ghost"
            size="icon"
            className="rounded-full text-gray-600 hover:bg-gray-100"
            onClick={handleClose}
          >
            <X className="h-5 w-5" />
          </Button>
          
          <div className="px-3 py-1.5 bg-teal-50 rounded-full text-xs font-medium text-teal-700 uppercase tracking-wide">
            Servings
          </div>
        </div>

        <div className="flex flex-col flex-1 px-5 pt-6 overflow-y-auto pb-20">
          {/* Recipe title */}
          <div className="mb-8">
            <h2 className="text-3xl font-bold text-gray-800">
              {recipe.name}
            </h2>
          </div>
          
          <div className="mb-10">
            <div className="bg-gradient-to-r from-blue-50 to-indigo-50 p-8 text-center rounded-xl border border-blue-100 shadow-sm">
              <h3 className="text-xl text-gray-700 mb-8">
                How many servings?
              </h3>
              
              <div className="flex items-center justify-center mb-8">
                <Button 
                  variant="outline" 
                  size="icon" 
                  className="h-14 w-14 rounded-full border border-blue-200 hover:bg-blue-100 text-blue-700"
                  onClick={decrementServingSize}
                  disabled={servingSize <= 1}
                >
                  <Minus className="h-6 w-6" />
                </Button>
                
                <div className="w-32 mx-6 text-center">
                  <div className="text-6xl font-bold text-blue-700">
                    {servingSize}
                  </div>
                </div>
                
                <Button 
                  variant="outline" 
                  size="icon" 
                  className="h-14 w-14 rounded-full border border-blue-200 hover:bg-blue-100 text-blue-700"
                  onClick={incrementServingSize}
                  disabled={servingSize >= 12}
                >
                  <Plus className="h-6 w-6" />
                </Button>
              </div>
            </div>
          </div>
          
          {/* Nutrition info */}
          <div className="mb-6">
            <div className="bg-gradient-to-r from-purple-50 to-blue-50 p-5 rounded-xl border border-purple-100 shadow-sm">
              <h3 className="text-lg font-bold text-gray-700 mb-4 flex items-center">
                <div className="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center mr-3">
                  <CakeSlice className="h-4 w-4 text-purple-600" />
                </div>
                Nutrition Per Serving
              </h3>
              
              <div className="grid grid-cols-2 gap-4">
                <div className="bg-white p-4 rounded-lg shadow-sm flex flex-col items-center justify-center border border-blue-50">
                  <span className="text-sm text-gray-500 mb-1">Calories</span>
                  <span className="text-2xl font-bold text-gray-800">
                    {Math.round(recipe.nutritionInfo.calories / originalServingCount)}
                  </span>
                </div>
                
                <div className="bg-white p-4 rounded-lg shadow-sm flex flex-col items-center justify-center border border-purple-50">
                  <span className="text-sm text-gray-500 mb-1">Protein</span>
                  <span className="text-2xl font-bold text-gray-800">
                    {Math.round(recipe.nutritionInfo.protein / originalServingCount)}g
                  </span>
                </div>
                
                <div className="bg-white p-4 rounded-lg shadow-sm flex flex-col items-center justify-center border border-blue-50">
                  <span className="text-sm text-gray-500 mb-1">Carbs</span>
                  <span className="text-2xl font-bold text-gray-800">
                    {Math.round(recipe.nutritionInfo.carbs / originalServingCount)}g
                  </span>
                </div>
                
                <div className="bg-white p-4 rounded-lg shadow-sm flex flex-col items-center justify-center border border-purple-50">
                  <span className="text-sm text-gray-500 mb-1">Fat</span>
                  <span className="text-2xl font-bold text-gray-800">
                    {Math.round(recipe.nutritionInfo.fat / originalServingCount)}g
                  </span>
                </div>
              </div>
            </div>
          </div>
          
          <div className="mb-8">
            <div className="bg-gradient-to-r from-teal-50 to-cyan-50 p-5 rounded-xl border border-teal-100 shadow-sm">
              <h3 className="text-lg font-bold text-gray-700 mb-4 flex items-center">
                <div className="w-8 h-8 bg-teal-100 rounded-full flex items-center justify-center mr-3">
                  <Scale className="h-4 w-4 text-teal-600" />
                </div>
                Total Nutrition
              </h3>
              
              <div className="bg-white p-4 rounded-lg shadow-sm mb-4 border border-teal-50">
                <div className="flex justify-between items-center">
                  <div>
                    <span className="text-sm text-gray-500">Original Recipe</span>
                    <p className="font-medium text-gray-700">
                      {originalServingCount} servings
                    </p>
                  </div>
                  <div className="text-right">
                    <span className="text-sm text-gray-500">Calories</span>
                    <p className="font-medium text-gray-700">
                      {recipe.nutritionInfo.calories}
                    </p>
                  </div>
                </div>
              </div>
              
              <div className="bg-white p-4 rounded-lg shadow-sm border border-cyan-50">
                <div className="flex justify-between items-center">
                  <div>
                    <span className="text-sm text-gray-500">Your Selection</span>
                    <p className="font-bold text-teal-600">
                      {servingSize} servings
                    </p>
                  </div>
                  <div className="text-right">
                    <span className="text-sm text-gray-500">Calories</span>
                    <p className="font-bold text-teal-600">
                      {Math.round(recipe.nutritionInfo.calories / originalServingCount * servingSize)}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          {/* Ingredients list */}
          <div className="mb-10">
            <h3 className="uppercase text-xs tracking-wider text-gray-500 font-semibold mb-4 flex items-center">
              <ShoppingBag className="h-4 w-4 text-teal-700 mr-2" />
              Ingredients
            </h3>
            
            <div className="space-y-4">
              {adjustedIngredients.map((ingredient, index) => (
                <div key={index} className="flex items-center">
                  <div className="w-1.5 h-1.5 bg-teal-500 rounded-full mr-3"></div>
                  <p className="text-gray-700">{ingredient}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
        
        {/* Fixed footer */}
        <div className="sticky bottom-0 left-0 right-0 -mx-5 px-5 pt-8 pb-6 bg-gradient-to-t from-white via-white to-transparent">
          <div className="relative">
            <div className="absolute -inset-1.5 bg-gradient-to-r from-indigo-500/50 to-blue-500/50 blur-md rounded-xl opacity-70"></div>
            <Button
              onClick={proceedToIngredients}
              className="relative w-full py-6 rounded-xl font-extrabold text-xl bg-gradient-to-r from-indigo-500 to-blue-500 text-white hover:from-indigo-600 hover:to-blue-600 shadow-lg"
            >
              <div className="flex items-center justify-center">
                Continue to Prep
                <ArrowRight className="ml-3 h-7 w-7" />
              </div>
            </Button>
          </div>
        </div>
      </div>
    );
  }
  
  // Ingredients preparation screen
  if (showIngredientsPrep) {
    return (
      <div className="fixed inset-0 bg-white z-[9999] flex flex-col">
        {/* Header Bar */}
        <div className="flex justify-between items-center z-10 px-5 py-4 bg-white shadow-sm">
          <Button
            variant="ghost"
            size="icon"
            className="rounded-full text-gray-600 hover:bg-gray-100"
            onClick={() => setShowServingSelector(true)}
          >
            <ChevronLeft className="h-5 w-5" />
          </Button>
          
          <div className="px-3 py-1.5 bg-teal-50 rounded-full text-xs font-medium text-teal-700 uppercase tracking-wide">
            Prep
          </div>
        </div>

        <div className="flex flex-col flex-1 px-5 pt-6 overflow-y-auto pb-20">
          {/* Title */}
          <div className="mb-8">
            <h2 className="text-3xl font-bold text-gray-800">
              {recipe.name}
            </h2>
            <p className="text-gray-500 mt-2">
              Get everything ready before you start
            </p>
          </div>
          
          {/* Mise en place section */}
          <div className="mb-8 bg-gradient-to-r from-teal-50 to-blue-50 p-5 rounded-xl border border-teal-100 shadow-sm">
            <div className="flex items-center mb-4">
              <div className="w-10 h-10 rounded-full bg-teal-100 flex items-center justify-center mr-3">
                <ShoppingBag className="h-5 w-5 text-teal-600" />
              </div>
              <div>
                <h3 className="text-sm font-bold text-teal-700">Mise en Place</h3>
                <p className="text-xs text-gray-500">Prep and organize all ingredients before cooking</p>
              </div>
            </div>
            
            <div className="space-y-3">
              {adjustedIngredients.map((ingredient, index) => {
                // Alternate between different colored cards
                const bgColors = ['bg-blue-50', 'bg-purple-50', 'bg-teal-50', 'bg-indigo-50', 'bg-cyan-50'];
                const borderColors = ['border-blue-100', 'border-purple-100', 'border-teal-100', 'border-indigo-100', 'border-cyan-100'];
                const textColors = ['text-blue-600', 'text-purple-600', 'text-teal-600', 'text-indigo-600', 'text-cyan-600'];
                
                return (
                  <div key={index} className={`flex items-center p-3 bg-white border ${borderColors[index % 5]} rounded-lg shadow-sm`}>
                    <div className={`w-8 h-8 ${bgColors[index % 5]} rounded-full flex items-center justify-center mr-3 shadow-sm`}>
                      <span className={`font-semibold ${textColors[index % 5]}`}>{index + 1}</span>
                    </div>
                    <p className="text-gray-700 flex-1">{ingredient}</p>
                  </div>
                );
              })}
            </div>
          </div>
          
          {/* Tools and equipment section */}
          <div className="mb-8 bg-gradient-to-r from-purple-50 to-indigo-50 p-5 rounded-xl border border-purple-100 shadow-sm">
            <div className="flex items-center mb-4">
              <div className="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center mr-3">
                <Utensils className="h-5 w-5 text-purple-600" />
              </div>
              <div>
                <h3 className="text-sm font-bold text-purple-700">Kitchen Equipment</h3>
                <p className="text-xs text-gray-500">Tools you'll need for this recipe</p>
              </div>
            </div>
            
            <div className="grid grid-cols-2 gap-3">
              <div className="bg-white border border-purple-100 rounded-lg p-3 shadow-sm flex items-center">
                <div className="w-6 h-6 bg-purple-50 rounded-full flex-shrink-0 flex items-center justify-center mr-2">
                  <span className="text-purple-600 text-xs">1</span>
                </div>
                <p className="text-gray-700">Mixing Bowl</p>
              </div>
              <div className="bg-white border border-indigo-100 rounded-lg p-3 shadow-sm flex items-center">
                <div className="w-6 h-6 bg-indigo-50 rounded-full flex-shrink-0 flex items-center justify-center mr-2">
                  <span className="text-indigo-600 text-xs">2</span>
                </div>
                <p className="text-gray-700">Measuring Cups</p>
              </div>
              <div className="bg-white border border-purple-100 rounded-lg p-3 shadow-sm flex items-center">
                <div className="w-6 h-6 bg-purple-50 rounded-full flex-shrink-0 flex items-center justify-center mr-2">
                  <span className="text-purple-600 text-xs">3</span>
                </div>
                <p className="text-gray-700">Cutting Board</p>
              </div>
              <div className="bg-white border border-indigo-100 rounded-lg p-3 shadow-sm flex items-center">
                <div className="w-6 h-6 bg-indigo-50 rounded-full flex-shrink-0 flex items-center justify-center mr-2">
                  <span className="text-indigo-600 text-xs">4</span>
                </div>
                <p className="text-gray-700">Chef's Knife</p>
              </div>
            </div>
          </div>
          
          {/* Chef's tip */}
          <div className="mb-8">
            <div className="bg-gradient-to-r from-amber-50 to-yellow-50 p-5 rounded-xl border border-amber-100 shadow-sm">
              <div className="flex items-start">
                <div className="flex-shrink-0 w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center mr-4">
                  <Lightbulb className="h-5 w-5 text-amber-500" />
                </div>
                <div>
                  <h3 className="text-sm font-bold text-amber-700 mb-2">
                    Chef's Pro Tip
                  </h3>
                  <p className="text-gray-700">
                    "Mise en place" (everything in its place) is a French culinary philosophy. Having all ingredients prepared and organized before cooking ensures a smooth, efficient cooking process.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        {/* Fixed footer */}
        <div className="sticky bottom-0 left-0 right-0 -mx-5 px-5 pt-8 pb-6 bg-gradient-to-t from-white via-white to-transparent">
          <div className="relative">
            <div className="absolute -inset-1.5 bg-gradient-to-r from-blue-500/50 to-teal-500/50 blur-md rounded-xl opacity-70"></div>
            <Button
              onClick={startCooking}
              className="relative w-full py-6 rounded-xl font-extrabold text-xl bg-gradient-to-r from-blue-500 to-teal-500 text-white hover:from-blue-600 hover:to-teal-600 shadow-lg"
            >
              <div className="flex items-center justify-center">
                <ChefHat className="mr-3 h-7 w-7" />
                Begin Cooking
              </div>
            </Button>
          </div>
        </div>
      </div>
    );
  }
  
  // Cooking mode screens for instruction steps
  if (cookingStarted) {
    return (
      <div className="fixed inset-0 bg-white z-[9999] flex flex-col">
        {/* Header Bar with minimal design */}
        <div className="flex justify-between items-center z-10 px-5 py-4 bg-white shadow-sm">
          <Button
            variant="ghost"
            size="icon"
            className="rounded-full text-gray-600 hover:bg-gray-100"
            onClick={handleClose}
          >
            <X className="h-5 w-5" />
          </Button>
          
          <div className="px-3 py-1.5 bg-teal-50 rounded-full text-xs font-medium text-teal-700">
            STEP {currentStep + 1}/{totalSteps}
          </div>
        </div>

        {/* Progress indicator */}
        <div className="flex justify-center mt-3 mb-6">
          <div className="flex space-x-2">
            {instructionSteps.map((_: any, index: number) => {
              // Create different colors for each step
              const stepColors = [
                'from-blue-400 to-blue-500',
                'from-purple-400 to-purple-500',
                'from-green-400 to-green-500',
                'from-amber-400 to-amber-500',
                'from-pink-400 to-pink-500',
                'from-indigo-400 to-indigo-500',
                'from-red-400 to-red-500'
              ];
              
              const colorClass = stepColors[index % stepColors.length];
              
              return (
                <div
                  key={index}
                  className={`h-2 rounded-full transition-all duration-300 ${
                    index === currentStep 
                      ? `w-10 bg-gradient-to-r ${colorClass}` 
                      : index < currentStep 
                        ? 'w-6 bg-teal-500' 
                        : 'w-6 bg-gray-200'
                  }`}
                />
              );
            })}
          </div>
        </div>

        {/* Main scrollable content - recipe steps */}
        <div className="flex-1 overflow-y-auto px-5 pb-24">
          {/* Large step number with colorful badge */}
          <div className="mb-8">
            <div className="flex items-center">
              <div className="relative">
                <div className="absolute -inset-1 rounded-full bg-gradient-to-r from-teal-400 to-teal-500 opacity-20 blur-md"></div>
                <div className="h-16 w-16 rounded-full bg-gradient-to-r from-teal-400 to-teal-500 flex items-center justify-center relative shadow-md">
                  <span className="text-2xl font-bold text-white">
                    {currentStep + 1}
                  </span>
                </div>
              </div>
              <div className="ml-4">
                <span className="text-lg font-medium text-teal-600 block">
                  {currentStep === 0 ? "Let's begin!" : 
                   currentStep === totalSteps - 1 ? "Final step!" : "Step " + (currentStep + 1)}
                </span>
                <span className="text-sm text-gray-500">
                  {currentStep === 0 ? "Get ready to start cooking" : 
                   currentStep === totalSteps - 1 ? "Almost finished" : "Keep going"}
                </span>
              </div>
            </div>
          </div>
          
          {/* Instruction Text */}
          <div className="mb-8 bg-gradient-to-r from-teal-50 to-blue-50 p-5 rounded-xl border border-teal-100 shadow-sm">
            <h2 className="text-2xl font-bold text-gray-800 mb-3">
              {recipe.name}
            </h2>
            <p className="text-xl leading-relaxed text-gray-700">
              {typeof instructionSteps[currentStep] === 'string' 
                ? instructionSteps[currentStep].replace(/^(\d+)[\.\)\-]\s*/, '') // Remove numbering if present
                : instructionSteps[currentStep]}
            </p>
          </div>
          
          {/* Ingredients for this step */}
          <div className="mb-8 bg-gradient-to-r from-blue-50 to-teal-50 p-5 rounded-xl border border-blue-100 shadow-sm">
            <h3 className="uppercase text-xs tracking-wider text-blue-700 font-semibold mb-3 flex items-center">
              <ShoppingBag className="h-5 w-5 text-blue-500 mr-2" />
              Ingredients for this step
            </h3>
            
            <div className="space-y-4">
              {adjustedIngredients.slice(0, Math.min(3, adjustedIngredients.length)).map((ingredient, index) => {
                // Alternate between different colored cards
                const bgColors = ['bg-blue-50', 'bg-purple-50', 'bg-teal-50'];
                const borderColors = ['border-blue-100', 'border-purple-100', 'border-teal-100'];
                const textColors = ['text-blue-600', 'text-purple-600', 'text-teal-600'];
                
                return (
                  <div key={index} className={`flex items-center p-3 ${bgColors[index % 3]} border ${borderColors[index % 3]} rounded-lg shadow-sm`}>
                    <div className={`w-7 h-7 rounded-full ${bgColors[(index + 2) % 3]} flex items-center justify-center mr-3 shadow-sm`}>
                      <span className={`text-xs font-semibold ${textColors[index % 3]}`}>{index + 1}</span>
                    </div>
                    <p className="text-gray-700">{ingredient}</p>
                  </div>
                );
              })}
            </div>
          </div>
          
          {/* Tips in a modern style */}
          {currentStep > 0 && currentStep < totalSteps - 1 && (
            <div className="mb-6 bg-gradient-to-r from-amber-50 to-yellow-50 p-5 rounded-xl border border-amber-100 shadow-sm">
              <div className="flex items-start">
                <div className="flex-shrink-0 w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center mr-4">
                  <Lightbulb className="h-5 w-5 text-amber-500" />
                </div>
                <div>
                  <h3 className="text-sm font-bold text-amber-700 mb-2">
                    Pro Tip
                  </h3>
                  <p className="text-gray-700">
                    {currentStep === 1 ? "Take your time and enjoy the process - rushing compromises flavor." : 
                     currentStep === 2 ? "Precision matters - use measuring tools for consistent results every time." : 
                     "A clean workspace not only looks professional but improves your focus and efficiency."}
                  </p>
                </div>
              </div>
            </div>
          )}
        </div>
        
        {/* Navigation Controls with improved colorful design */}
        <div className="sticky bottom-0 left-0 right-0 p-5 pt-8 bg-gradient-to-t from-white via-white to-transparent">
          <div className="flex justify-between">
            <Button
              variant="outline"
              onClick={goToPrevStep}
              disabled={currentStep === 0}
              className={`px-6 py-3 rounded-xl shadow-sm border ${
                currentStep === 0 
                  ? 'opacity-50 cursor-not-allowed text-gray-300 border-gray-200' 
                  : 'text-gray-600 hover:bg-gray-50 border-gray-200'
              }`}
            >
              <ChevronLeft className="mr-2 h-5 w-5" />
              Back
            </Button>
            
            <Button
              onClick={goToNextStep}
              className={`px-8 py-3 rounded-xl font-medium shadow-md ${
                currentStep < totalSteps - 1 
                  ? 'bg-gradient-to-r from-teal-500 to-blue-500 hover:from-teal-600 hover:to-blue-600' 
                  : 'bg-gradient-to-r from-green-500 to-teal-500 hover:from-green-600 hover:to-teal-600'
              } text-white`}
            >
              {currentStep < totalSteps - 1 ? (
                <>
                  Next Step
                  <ChevronRight className="ml-2 h-5 w-5" />
                </>
              ) : (
                <>
                  Complete
                  <Check className="ml-2 h-5 w-5" />
                </>
              )}
            </Button>
          </div>
        </div>
      </div>
    );
  }
  
  // Default return (should not happen with the state flags we've set up)
  return (
    <div className="fixed inset-0 bg-white flex items-center justify-center z-50">
      <div className="text-center">
        <div className="inline-block w-12 h-12 border-4 border-t-teal-500 border-solid border-gray-200 rounded-full animate-spin mb-4"></div>
        <p className="text-gray-600">Preparing your cooking experience...</p>
      </div>
    </div>
  );
}