import React, { useState, useRef, useCallback, useEffect } from 'react';
import { useLocation } from 'wouter';
import { useQuery } from '@tanstack/react-query';
import { motion, AnimatePresence } from 'framer-motion';
import { useUser } from '@/hooks/use-user';
import { useToast } from '@/hooks/use-toast';
import { useProgressPhotos } from '@/hooks/use-progress-photos';
import { useBodyAnalysis } from '@/hooks/use-body-analysis';
import { Card } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Dialog, DialogHeader, DialogContent, DialogTitle } from '@/components/ui/dialog';
import { Input } from '@/components/ui/input';
import { Loader2 } from 'lucide-react';
import {
  ChevronLeft,
  ChevronDown,
  ChevronUp,
  ChevronRight,
  Camera,
  Upload,
  User,
  Settings,
  LogOut,
  Clock,
  Heart,
  Star,
  Trash2,
  Scale,
  Ruler,
  Activity,
  BarChart3,
  Trophy,
  X,
  Check,
} from 'lucide-react';
import { Link } from 'wouter';

type BodyFatStep = "photo" | "weight" | "height" | "result";

function CameraCapture({ onClose, onPhotoCapture }: { onClose: () => void; onPhotoCapture: (photoUrl: string) => Promise<void> }) {
  const videoRef = useRef<HTMLVideoElement>(null);
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const [isCaptureReady, setIsCaptureReady] = useState(false);
  const [isProcessing, setIsProcessing] = useState(false);

  useEffect(() => {
    let stream: MediaStream | null = null;

    const startCamera = async () => {
      try {
        stream = await navigator.mediaDevices.getUserMedia({
          video: {
            facingMode: 'user',
            width: { ideal: 1280 },
            height: { ideal: 720 }
          },
          audio: false
        });

        if (videoRef.current) {
          videoRef.current.srcObject = stream;
          setIsCaptureReady(true);
        }
      } catch (err) {
        console.error('Error accessing camera:', err);
        setIsCaptureReady(false);
      }
    };

    startCamera();

    return () => {
      if (stream) {
        stream.getTracks().forEach(track => track.stop());
      }
    };
  }, []);

  const capturePhoto = useCallback(async () => {
    if (!canvasRef.current || !videoRef.current || isProcessing) return;
    
    setIsProcessing(true);
    
    try {
      const canvas = canvasRef.current;
      const video = videoRef.current;
      
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Could not get canvas context');
      
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
      
      const dataUrl = canvas.toDataURL('image/jpeg', 0.8);
      await onPhotoCapture(dataUrl);
    } catch (error) {
      console.error('Error capturing photo:', error);
    } finally {
      setIsProcessing(false);
    }
  }, [onPhotoCapture, isProcessing]);

  return (
    <div className="fixed inset-0 bg-black/90 backdrop-blur-md z-50 flex items-center justify-center">
      <div className="relative max-w-md w-full mx-auto p-4">
        <Button
          variant="ghost"
          size="icon"
          onClick={onClose}
          className="absolute top-2 right-2 z-10 text-white"
        >
          <X className="h-6 w-6" />
        </Button>
        
        <div className="aspect-[3/4] bg-black rounded-2xl overflow-hidden">
          <video
            ref={videoRef}
            autoPlay
            playsInline
            muted
            className="h-full w-full object-cover"
          />
        </div>
        
        <canvas ref={canvasRef} className="hidden" />
        
        <div className="mt-4 flex justify-center">
          <Button
            onClick={capturePhoto}
            className="rounded-full h-16 w-16 bg-white p-4 flex items-center justify-center"
            disabled={!isCaptureReady || isProcessing}
          >
            <div className="rounded-full border-2 border-[#0CC5BA] h-12 w-12 flex items-center justify-center">
              {isProcessing ? (
                <div className="h-3 w-3 rounded-full bg-[#0CC5BA] animate-ping" />
              ) : (
                <div className="h-3 w-3 rounded-full bg-[#0CC5BA]" />
              )}
            </div>
          </Button>
        </div>
      </div>
    </div>
  );
}

export default function ProgressPage() {
  const [location, setLocation] = useLocation();
  const { toast } = useToast();
  const { user, logout, updateProfile } = useUser();
  const { addPhoto, photos, updatePhotoType, isLoading: isPhotoLoading } = useProgressPhotos();
  const { analyzeBody, updateProfileWithBodyFat, isLoading: isBodyAnalysisLoading, isAnalyzing, isUpdating, result: bodyAnalysisResult } = useBodyAnalysis();
  const { data: xpData } = useQuery<{ totalXP: number; level: number; streak: number; longestStreak: number }>({
    queryKey: ["/api/xp"],
  });

  // Initialize state variables
  const [currentSection, setCurrentSection] = useState(0);
  const [isDialogOpen, setIsDialogOpen] = useState(false);
  const [isHeightDialogOpen, setIsHeightDialogOpen] = useState(false);
  const [newWeight, setNewWeight] = useState(user?.profile?.weight || 70);
  const [weight, setWeight] = useState(user?.profile?.weight || 70);
  const [height, setHeight] = useState<number>(user?.profile?.height || 170);
  const [isBodyFatDialogOpen, setIsBodyFatDialogOpen] = useState(false);
  const [currentBodyFatStep, setCurrentBodyFatStep] = useState<BodyFatStep>("photo");
  const [bodyFatAnalysisComplete, setBodyFatAnalysisComplete] = useState(false);

  // Image and gallery state
  const [isCameraOpen, setIsCameraOpen] = useState(false);
  const [isGalleryOpen, setIsGalleryOpen] = useState(false);
  const [selectedPhoto, setSelectedPhoto] = useState<string | null>(null);
  const [isDropdownOpen, setIsDropdownOpen] = useState(false);
  const dropdownRef = useRef<HTMLDivElement>(null);

  // Current user settings
  const currentWeight = user?.profile?.weight || 70;
  const userInitial = user?.email?.charAt(0).toUpperCase() || "U";
  const level = Math.floor((xpData?.totalXP || 0) / 100) + 1;

  // Progress sections
  const progressSections = [
    {
      id: "stats",
      title: "Your Statistics",
      description: "Track your key metrics",
      icon: <BarChart3 className="w-8 h-8 text-[#0CC5BA]" />,
      gradient: "from-[#0CC5BA] to-teal-500"
    },
    {
      id: "bodyComposition",
      title: "Body Composition",
      description: "Monitor your physical changes",
      icon: <Activity className="w-8 h-8 text-[#0CC5BA]" />,
      gradient: "from-blue-500 to-indigo-500"
    },
    {
      id: "photos",
      title: "Progress Photos",
      description: "See your transformation journey",
      icon: <Camera className="w-8 h-8 text-[#0CC5BA]" />,
      gradient: "from-purple-500 to-pink-500"
    },
    {
      id: "streaks",
      title: "Streaks & Achievements",
      description: "Your consistency journey",
      icon: <Trophy className="w-8 h-8 text-[#0CC5BA]" />,
      gradient: "from-amber-500 to-orange-500"
    }
  ];

  // Animation variants
  const containerVariants = {
    hidden: { opacity: 0 },
    show: {
      opacity: 1,
      transition: {
        staggerChildren: 0.1,
        delayChildren: 0.3
      }
    }
  };

  const itemVariants = {
    hidden: { opacity: 0, y: 20 },
    show: { opacity: 1, y: 0 }
  };

  // Calculate BMI and body fat percentage
  const bmi = Math.round((currentWeight / Math.pow(height / 100, 2)) * 10) / 10;

  // Calculate body fat percentage using BMI method
  const calculateBodyFat = (weightKg: number, heightCm: number) => {
    const bmi = weightKg / Math.pow(heightCm / 100, 2);
    const age = 25; // Default age if not set
    const isMale = true; // Default to male calculation

    // Body fat calculation using BMI method
    let bodyFat;
    if (isMale) {
      bodyFat = (1.20 * bmi) + (0.23 * age) - 16.2;
    } else {
      bodyFat = (1.20 * bmi) + (0.23 * age) - 5.4;
    }

    return Math.round(bodyFat * 10) / 10;
  };

  const bodyFatPercentage = calculateBodyFat(currentWeight, height);

  const handleUpdateHeight = async () => {
    try {
      if (user && updateProfile) {
        await updateProfile({
          ...user,
          height
        });

        toast({
          title: "Success",
          description: "Height updated successfully!",
          duration: 3000,
        });

        setIsHeightDialogOpen(false);
      }
    } catch (error) {
      console.error('Failed to update height:', error);
      toast({
        variant: "destructive",
        title: "Error",
        description: "Failed to update height. Please try again.",
      });
    }
  };

  const handleUpdateWeight = () => {
    if (user && updateProfile) {
      updateProfile({
        ...user,
        weight: newWeight
      });
    }
    setIsDialogOpen(false);
    toast({
      title: "Success",
      description: "Weight updated successfully!",
      duration: 3000,
    });
  };

  const handlePhotoUpload = async (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onloadend = async () => {
      const base64String = reader.result as string;
      try {
        await addPhoto({
          photoUrl: base64String,
          type: 'latest',
        });

        toast({
          title: "Success",
          description: "Photo uploaded successfully!",
          duration: 3000,
        });

        handleNextStep();
      } catch (error) {
        console.error('Failed to upload photo:', error);
        toast({
          variant: "destructive",
          title: "Error",
          description: "Failed to upload photo. Please try again.",
        });
      }
    };
    reader.readAsDataURL(file);
  };

  // Handle completion of body fat analysis
  const completeBodyFatAnalysis = async () => {
    try {
      // Get the latest photo for analysis - should be the first one in the photos array
      const latestPhoto = photos?.find(photo => photo.type === 'latest');
      
      if (!latestPhoto?.photoUrl) {
        throw new Error('No photo available for analysis');
      }
      
      // Use AI to analyze body composition
      const analysisResult = await analyzeBody(
        latestPhoto.photoUrl,
        weight,
        height,
        'male', // Default for now, could be made configurable
        30 // Default age, could be stored in user profile
      );
      
      console.log('Body analysis result:', analysisResult);
      
      // Update regular user profile with weight and height
      if (user && updateProfile) {
        await updateProfile({
          ...user,
          weight,
          height
        });
      }
      
      // Update user nutrition preferences with body fat percentage using the dedicated endpoint
      await updateProfileWithBodyFat(analysisResult.bodyFatPercentage);
        
      toast({
        title: "Analysis Complete!",
        description: `Your estimated body fat percentage is ${analysisResult.bodyFatPercentage}%`,
        duration: 5000,
      });
      
      setBodyFatAnalysisComplete(true);
      setCurrentBodyFatStep("result");
    } catch (error) {
      console.error('Failed to complete body fat analysis:', error);
      
      // Fallback to BMI calculation if AI analysis fails
      const bodyFatPercentage = calculateBodyFat(weight, height);
      
      if (user && updateProfile) {
        // Update regular user profile with weight and height
        await updateProfile({
          ...user,
          weight,
          height
        });
        
        // Update body fat percentage using BMI method as fallback
        try {
          await updateProfileWithBodyFat(bodyFatPercentage);
        } catch (err) {
          console.error('Failed to update body fat percentage:', err);
        }
        
        toast({
          title: "Analysis Complete!",
          description: `Your estimated body fat percentage is ${bodyFatPercentage}% (using BMI method)`,
          duration: 5000,
        });
        
        setBodyFatAnalysisComplete(true);
        setCurrentBodyFatStep("result");
      }
    }
  };

  // Handle next step in body fat analysis
  const handleNextStep = useCallback(() => {
    switch (currentBodyFatStep) {
      case "photo":
        setCurrentBodyFatStep("weight");
        setIsCameraOpen(false);
        setIsBodyFatDialogOpen(true);
        break;
      case "weight":
        setCurrentBodyFatStep("height");
        break;
      case "height":
        completeBodyFatAnalysis();
        break;
    }
  }, [currentBodyFatStep, setIsCameraOpen, setIsBodyFatDialogOpen]);

  const handlePhotoClick = (photoUrl: string) => {
    setSelectedPhoto(photoUrl);
    setIsGalleryOpen(true);
  };

  const handleSetPhotoType = async (photoUrl: string, type: 'latest' | 'favorite' | 'first') => {
    try {
      await updatePhotoType({
        photoUrl,
        type
      });

      toast({
        title: "Success",
        description: `Photo marked as ${type}!`,
        duration: 3000,
      });
    } catch (error) {
      console.error('Failed to update photo type:', error);
      toast({
        variant: "destructive",
        title: "Error",
        description: "Failed to update photo type. Please try again.",
      });
    }
  };

  const streakData = {
    currentStreak: xpData?.streak || 0,
    longestStreak: xpData?.longestStreak || 0,
    level: Math.floor((xpData?.totalXP || 0) / 100) + 1,
    xp: xpData?.totalXP || 0,
    xpNeeded: (Math.floor((xpData?.totalXP || 0) / 100) + 1) * 100
  };

  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (dropdownRef.current && !dropdownRef.current.contains(event.target as Node)) {
        setIsDropdownOpen(false);
      }
    };

    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  const renderBodyFatButton = () => (
    <motion.div variants={itemVariants}>
      <Card className="p-6 rounded-[28px] border-[#0CC5BA]/10 bg-white mt-6">
        <div className="space-y-4">
          <div className="flex items-center gap-3">
            <div className="text-2xl">💪</div>
            <div>
              <h2 className="text-lg font-bold">Body Fat Analysis</h2>
              <p className="text-sm text-gray-500">Get an AI-powered estimate of your body fat percentage</p>
            </div>
          </div>
          <Button
            onClick={() => {
              setIsBodyFatDialogOpen(true);
              setCurrentBodyFatStep("photo");
              setBodyFatAnalysisComplete(false);
            }}
            className="w-full bg-[#0CC5BA] hover:bg-[#0CC5BA]/90 text-white"
          >
            Check Body Fat %
          </Button>
        </div>
      </Card>
    </motion.div>
  );

  const renderBodyFatDialog = () => (
    <Dialog open={isBodyFatDialogOpen} onOpenChange={setIsBodyFatDialogOpen}>
      <DialogContent className="max-w-lg">
        <DialogHeader>
          <DialogTitle>
            {currentBodyFatStep === "result"
              ? "Analysis Complete!"
              : "Body Fat Analysis"}
          </DialogTitle>
        </DialogHeader>
        <div className="p-4">
          {currentBodyFatStep === "photo" && (
            <div className="space-y-4">
              <p className="text-sm text-gray-600">
                First, let's take a current photo to track your progress.
              </p>
              <div className="flex gap-2">
                <Button
                  className="flex-1"
                  onClick={() => setIsCameraOpen(true)}
                >
                  <Camera className="w-4 h-4 mr-2" />
                  Take Photo
                </Button>
                <Button
                  className="flex-1"
                  onClick={() => document.getElementById('photo-upload')?.click()}
                >
                  <Upload className="w-4 h-4 mr-2" />
                  Upload Photo
                </Button>
              </div>
              <input
                id="photo-upload"
                type="file"
                accept="image/*"
                className="hidden"
                onChange={handlePhotoUpload}
              />
            </div>
          )}

          {currentBodyFatStep === "weight" && (
            <div className="space-y-4">
              <p className="text-sm text-gray-600">
                Now, let's update your current weight.
              </p>
              <div className="flex items-center gap-4">
                <Input
                  type="number"
                  value={weight}
                  onChange={(e: React.ChangeEvent<HTMLInputElement>) => setWeight(parseFloat(e.target.value))}
                  className="w-full"
                  placeholder="Enter your weight in kg"
                />
                <div className="flex gap-2">
                  <Button
                    variant="outline"
                    size="icon"
                    onClick={() => setWeight((prev: number) => prev - 0.1)}
                  >
                    <ChevronDown className="h-4 w-4" />
                  </Button>
                  <Button
                    variant="outline"
                    size="icon"
                    onClick={() => setWeight((prev: number) => prev + 0.1)}
                  >
                    <ChevronUp className="h-4 w-4" />
                  </Button>
                </div>
              </div>
              <Button
                className="w-full bg-[#0CC5BA] hover:bg-[#0CC5BA]/90 text-white"
                onClick={handleNextStep}
              >
                Continue
              </Button>
            </div>
          )}

          {currentBodyFatStep === "height" && (
            <div className="space-y-4">
              <p className="text-sm text-gray-600">
                Finally, let's confirm your height.
              </p>
              <div className="flex items-center gap-4">
                <Input
                  type="number"
                  value={height}
                  onChange={(e: React.ChangeEvent<HTMLInputElement>) => setHeight(parseFloat(e.target.value))}
                  className="w-full"
                  placeholder="Enter your height in cm"
                />
                <div className="flex gap-2">
                  <Button
                    variant="outline"
                    size="icon"
                    onClick={() => setHeight((prev: number) => prev - 1)}
                  >
                    <ChevronDown className="h-4 w-4" />
                  </Button>
                  <Button
                    variant="outline"
                    size="icon"
                    onClick={() => setHeight((prev: number) => prev + 1)}
                  >
                    <ChevronUp className="h-4 w-4" />
                  </Button>
                </div>
              </div>
              <Button
                className="w-full bg-[#0CC5BA] hover:bg-[#0CC5BA]/90 text-white"
                onClick={handleNextStep}
              >
                Calculate Body Fat %
              </Button>
            </div>
          )}

          {currentBodyFatStep === "result" && (
            <div className="space-y-4">
              {isAnalyzing || isUpdating ? (
                <div className="flex flex-col items-center justify-center py-8">
                  <Loader2 className="h-10 w-10 text-[#0CC5BA] animate-spin mb-4" />
                  <p className="text-sm text-gray-500">
                    {isAnalyzing ? "Analyzing your body composition..." : "Updating your profile..."}
                  </p>
                </div>
              ) : bodyFatAnalysisComplete ? (
                <>
                  <div className="flex justify-between items-center">
                    <div>
                      <div className="text-3xl font-bold text-[#0CC5BA]">
                        {bodyAnalysisResult?.bodyFatPercentage || calculateBodyFat(weight, height)}%
                      </div>
                      <div className="text-sm text-gray-500">Estimated body fat</div>
                    </div>
                    <div className="text-right">
                      <div className="text-sm font-semibold">
                        {bodyAnalysisResult?.bodyType || "Unknown"}
                      </div>
                      <div className="text-xs text-gray-500">Body type</div>
                    </div>
                  </div>
                  
                  {bodyAnalysisResult?.muscleMass && (
                    <div className="flex items-center justify-between py-2 px-3 bg-gray-50 rounded-lg">
                      <span className="text-sm font-medium">Muscle Mass</span>
                      <span className="text-sm">{bodyAnalysisResult.muscleMass}</span>
                    </div>
                  )}

                  <div className="space-y-3">
                    <div className="relative h-2 bg-gradient-to-r from-green-500 via-yellow-500 to-red-500 rounded-full overflow-hidden">
                      <div
                        className="absolute w-2 h-4 bg-black -top-1 rounded-full"
                        style={{ 
                          left: `${((bodyAnalysisResult?.bodyFatPercentage || calculateBodyFat(weight, height)) / 40) * 100}%` 
                        }}
                      />
                    </div>

                    <div className="flex justify-between text-xs text-gray-500">
                      <span>Essential Fat</span>
                      <span>Athletic</span>
                      <span>Fitness</span>
                      <span>Average</span>
                      <span>Obese</span>
                    </div>
                  </div>
                  
                  {bodyAnalysisResult?.bodyCompositionNotes && (
                    <div className="mt-4 p-3 bg-blue-50 rounded-lg text-sm">
                      <p className="font-medium mb-1 text-blue-800">Analysis Notes</p>
                      <p className="text-gray-700">{bodyAnalysisResult.bodyCompositionNotes}</p>
                    </div>
                  )}
                  
                  {bodyAnalysisResult?.improvementSuggestions && bodyAnalysisResult.improvementSuggestions.length > 0 && (
                    <div className="mt-4">
                      <p className="font-medium mb-2 text-sm">Suggestions for Improvement</p>
                      <ul className="space-y-1">
                        {bodyAnalysisResult.improvementSuggestions.map((suggestion, index) => (
                          <li key={index} className="flex items-start text-sm">
                            <span className="mr-2 text-[#0CC5BA]">•</span>
                            <span>{suggestion}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  
                  {bodyAnalysisResult && (
                    <div className="flex items-center gap-1 text-xs text-gray-500 mt-4">
                      <div className="h-1.5 w-1.5 rounded-full bg-gray-300"></div>
                      <span>Analysis confidence: {bodyAnalysisResult.confidence}%</span>
                    </div>
                  )}
                  
                  <div className="flex gap-3 mt-2">
                    <Button
                      className="flex-1"
                      variant="outline"
                      onClick={() => setIsBodyFatDialogOpen(false)}
                    >
                      Close
                    </Button>
                    <Button
                      className="flex-1 bg-[#0CC5BA] hover:bg-[#0CC5BA]/90 text-white"
                      onClick={() => {
                        setIsBodyFatDialogOpen(false);
                        setLocation("/progress");
                      }}
                    >
                      Save Results
                    </Button>
                  </div>
                </>
              ) : (
                <div className="flex flex-col items-center justify-center py-6">
                  <div className="text-center mb-4">
                    <p className="text-gray-600 mb-2">No analysis results yet</p>
                    <p className="text-sm text-gray-500">Take a photo to analyze your body composition</p>
                  </div>
                  <Button 
                    onClick={() => setCurrentBodyFatStep("photo")}
                    className="bg-[#0CC5BA] hover:bg-[#0CC5BA]/90 text-white"
                  >
                    Take Photo
                  </Button>
                </div>
              )}
            </div>
          )}
        </div>
      </DialogContent>
    </Dialog>
  );

  // Update the handlePhotoCapture function in the main component
  const handlePhotoCapture = async (imageSrc: string) => {
    try {
      console.log('Processing captured photo...');

      if (!imageSrc) {
        throw new Error('No image data received');
      }

      // Add photo directly using the hook
      await addPhoto({
        photoUrl: imageSrc,
        type: 'latest'
      });

      console.log('Photo uploaded successfully');
      toast({
        title: "Success",
        description: "Photo uploaded successfully!"
      });

      setIsCameraOpen(false);
      handleNextStep();
    } catch (error) {
      console.error('Failed to handle photo:', error);
      toast({
        variant: "destructive",
        title: "Error",
        description: "Failed to save photo"
      });
    }
  };

  // Add authentication check
  useEffect(() => {
    if (!user) {
      toast({
        variant: "destructive",
        title: "Authentication Required",
        description: "Please log in to access this feature",
      });
      setLocation("/auth"); // Redirect to auth page
      return;
    }
  }, [user, toast, setLocation]);

  const handleCameraOpen = () => {
    if (!user) {
      toast({
        variant: "destructive",
        title: "Authentication Required",
        description: "Please log in to use the camera feature",
      });
      setLocation("/auth");
      return;
    }
    setIsCameraOpen(true);
  };

  const goToNext = () => {
    if (currentSection < progressSections.length - 1) {
      setCurrentSection(currentSection + 1);
    }
  };

  const goToPrevious = () => {
    if (currentSection > 0) {
      setCurrentSection(currentSection - 1);
    }
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-[#0CC5BA]/5 to-blue-500/5">
      <motion.header
        initial={{ y: -20, opacity: 0 }}
        animate={{ y: 0, opacity: 1 }}
        className="sticky top-0 w-full bg-white/80 backdrop-blur-md z-10 border-b border-white/20 shadow-sm"
      >
        <div className="w-full max-w-[500px] mx-auto px-4 sm:px-6 py-4">
          <div className="flex items-start sm:items-center justify-between gap-4">
            <div className="flex-1 min-w-0 space-y-2">
              <motion.h1
                initial={{ x: -20, opacity: 0 }}
                animate={{ x: 0, opacity: 1 }}
                className="text-2xl sm:text-3xl font-bold bg-gradient-to-br from-[#0CC5BA] via-[#0CBACC] to-[#0C9CCC] bg-clip-text text-transparent truncate"
              >
                Your Progress Journey
              </motion.h1>
              <motion.div
                initial={{ x: -20, opacity: 0 }}
                animate={{ x: 0, opacity: 1 }}
                transition={{ delay: 0.1 }}
                className="flex flex-wrap items-center gap-2"
              >
                <div className="h-7 px-3 rounded-full bg-[#0CC5BA] text-white text-sm font-medium flex items-center whitespace-nowrap">
                  Level {level}
                </div>
                <span className="text-sm sm:text-base text-gray-500 truncate">
                  Track your transformation journey
                </span>
              </motion.div>
            </div>
            <motion.div
              initial={{ scale: 0.5, opacity: 0 }}
              animate={{ scale: 1, opacity: 1 }}
              transition={{ delay: 0.2 }}
              className="relative"
              ref={dropdownRef}
            >
              <button
                className="w-12 h-12 rounded-full bg-[#0CC5BA] flex items-center justify-center text-white text-xl font-semibold hover:bg-[#0CC5BA]/90 transition-colors relative"
                onClick={() => setIsDropdownOpen(!isDropdownOpen)}
              >
                {userInitial}
                <div className="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-gradient-to-br from-blue-500 via-blue-600 to-blue-700 text-white text-xs flex items-center justify-center animate-gradient">
                  1
                </div>
              </button>
              {isDropdownOpen && (
                <motion.div
                  initial={{ opacity: 0, y: -10 }}
                  animate={{ opacity: 1, y: 0 }}
                  exit={{ opacity: 0, y: -10 }}
                  transition={{ duration: 0.2 }}
                  className="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg py-2 z-50"
                >
                  <Link href="/profile" className="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                    <div className="flex items-center">
                      <User className="w-4 h-4 mr-2" />
                      Profile
                    </div>
                  </Link>
                  <Link href="/settings" className="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                    <div className="flex items-center">
                      <Settings className="w-4 h-4 mr-2" />
                      Settings
                    </div>
                  </Link>
                  <button
                    onClick={() => logout && logout()}
                    className="w-full text-left block px-4 py-2 text-sm text-red-600 hover:bg-gray-100"
                  >
                    <div className="flex items-center">
                      <LogOut className="w-4 h-4 mr-2" />
                      Logout
                    </div>
                  </button>
                </motion.div>
              )}
            </motion.div>
          </div>
        </div>
      </motion.header>

      {/* Vertical progress page with side numbers */}
      <div className="max-w-[500px] mx-auto px-4 py-8">
        {/* Sections stacked vertically */}
        <div className="space-y-8">
          {progressSections.map((section, index) => (
            <div key={section.id} className="relative">
              {/* Section number on the side */}
              <div 
                className={`absolute -left-4 top-4 w-10 h-10 flex items-center justify-center rounded-full 
                  ${index === currentSection 
                    ? 'bg-gradient-to-br from-[#0CC5BA] to-blue-500 text-white' 
                    : 'bg-gray-200 text-gray-400'}`}
                onClick={() => setCurrentSection(index)}
              >
                <span className="text-sm font-medium">{index + 1}</span>
              </div>
              
              {/* Section content */}
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ duration: 0.3, delay: index * 0.1 }}
                className={`pl-8 pb-8 ${index !== progressSections.length - 1 ? 'border-l border-gray-200' : ''}`}
              >
                <div className="flex items-center gap-4 mb-4">
                  <div className={`w-16 h-16 rounded-xl flex items-center justify-center bg-gradient-to-br ${section.gradient} text-white`}>
                    {section.icon}
                  </div>
                  <div>
                    <h2 className="text-xl font-bold text-gray-800">{section.title}</h2>
                    <p className="text-sm text-gray-500">{section.description}</p>
                  </div>
                </div>
                
                {/* Section content only shows for the selected section */}
                {index === currentSection && (

          {/* Section content based on current section */}
          {currentSection === 0 && (
            <div className="space-y-4">
              <Card className="p-6 rounded-[28px] border-[#0CC5BA]/10 bg-white">
                <div className="flex items-center gap-3 mb-4">
                  <div className="w-10 h-10 rounded-full bg-[#0CC5BA]/10 flex items-center justify-center">
                    <Scale className="w-5 h-5 text-[#0CC5BA]" />
                  </div>
                  <div>
                    <h3 className="text-lg font-bold bg-gradient-to-br from-[#0CC5BA] to-blue-500 bg-clip-text text-transparent">Weight Metrics</h3>
                    <p className="text-sm text-gray-500">Current and target weight</p>
                  </div>
                </div>
                
                <div className="grid grid-cols-2 gap-4 mb-4">
                  <div className="p-4 bg-gray-50 rounded-xl">
                    <div className="text-sm text-gray-500">Current</div>
                    <div className="text-2xl font-bold">{currentWeight} kg</div>
                  </div>
                  <div className="p-4 bg-gray-50 rounded-xl">
                    <div className="text-sm text-gray-500">Goal</div>
                    <div className="text-2xl font-bold">{user?.profile ? "Set" : "--"} kg</div>
                  </div>
                </div>
                
                <Button 
                  onClick={() => setIsDialogOpen(true)} 
                  className="w-full bg-[#0CC5BA]/10 hover:bg-[#0CC5BA]/20 text-[#0CC5BA]"
                >
                  Update Weight
                </Button>
              </Card>
              
              <Card className="p-6 rounded-[28px] border-[#0CC5BA]/10 bg-white">
                <div className="flex items-center gap-3 mb-4">
                  <div className="w-10 h-10 rounded-full bg-blue-500/10 flex items-center justify-center">
                    <Activity className="w-5 h-5 text-blue-500" />
                  </div>
                  <div>
                    <h3 className="text-lg font-bold bg-gradient-to-br from-blue-500 to-indigo-500 bg-clip-text text-transparent">Body Metrics</h3>
                    <p className="text-sm text-gray-500">BMI and calculations</p>
                  </div>
                </div>
                
                <div className="grid grid-cols-2 gap-4 mb-4">
                  <div className="p-4 bg-gray-50 rounded-xl">
                    <div className="text-sm text-gray-500">BMI</div>
                    <div className="text-2xl font-bold">{bmi}</div>
                  </div>
                  <div className="p-4 bg-gray-50 rounded-xl">
                    <div className="text-sm text-gray-500">Height</div>
                    <div className="text-2xl font-bold">{height} cm</div>
                  </div>
                </div>
                
                <Button 
                  onClick={() => setIsHeightDialogOpen(true)} 
                  className="w-full bg-blue-500/10 hover:bg-blue-500/20 text-blue-500"
                >
                  Update Height
                </Button>
              </Card>
              
              {renderBodyFatButton()}
            </div>
          )}

          {currentSection === 1 && (
            <div className="space-y-4">
              <Card className="p-6 rounded-[28px] border-[#0CC5BA]/10 bg-white">
                <div className="flex items-center gap-3 mb-4">
                  <div className="w-10 h-10 rounded-full bg-indigo-500/10 flex items-center justify-center">
                    <Activity className="w-5 h-5 text-indigo-500" />
                  </div>
                  <div>
                    <h3 className="text-lg font-bold bg-gradient-to-br from-indigo-500 to-purple-500 bg-clip-text text-transparent">Body Composition</h3>
                    <p className="text-sm text-gray-500">Your detailed body analysis</p>
                  </div>
                </div>
                
                <div className="space-y-6 mt-4">
                  <div>
                    <div className="flex justify-between mb-2">
                      <span className="text-sm text-gray-500">Body Fat</span>
                      <span className="text-sm font-medium">{bodyFatPercentage}%</span>
                    </div>
                    <div className="h-2 w-full bg-gray-100 rounded-full overflow-hidden">
                      <div
                        className="h-full bg-gradient-to-r from-green-500 to-yellow-500 rounded-full"
                        style={{ width: `${Math.min(bodyFatPercentage * 3, 100)}%` }}
                      />
                    </div>
                  </div>
                  
                  <div>
                    <div className="flex justify-between mb-2">
                      <span className="text-sm text-gray-500">BMI</span>
                      <span className="text-sm font-medium">{bmi}</span>
                    </div>
                    <div className="h-2 w-full bg-gray-100 rounded-full overflow-hidden">
                      <div
                        className="h-full bg-gradient-to-r from-blue-500 to-indigo-500 rounded-full"
                        style={{ width: `${Math.min(bmi * 4, 100)}%` }}
                      />
                    </div>
                  </div>
                  
                  <div className="grid grid-cols-2 gap-4 mt-6">
                    <div className="bg-gray-50 p-4 rounded-xl">
                      <div className="text-gray-500 text-sm">Weight</div>
                      <div className="font-bold text-xl">{currentWeight} kg</div>
                    </div>
                    <div className="bg-gray-50 p-4 rounded-xl">
                      <div className="text-gray-500 text-sm">Height</div>
                      <div className="font-bold text-xl">{height} cm</div>
                    </div>
                  </div>
                  
                  <Button
                    onClick={() => {
                      setIsBodyFatDialogOpen(true);
                      setCurrentBodyFatStep("photo");
                      setBodyFatAnalysisComplete(false);
                    }}
                    className="w-full bg-gradient-to-r from-indigo-500 to-purple-500 hover:opacity-90 text-white"
                  >
                    Update Body Analysis
                  </Button>
                </div>
              </Card>
              
              {currentBodyFatStep === "result" && bodyFatAnalysisComplete && (
                <Card className="p-6 rounded-[28px] border-[#0CC5BA]/10 bg-white mt-6">
                  <div className="space-y-4">
                    <div className="flex justify-between items-center">
                      <div>
                        <div className="text-3xl font-bold text-[#0CC5BA]">
                          {calculateBodyFat(weight, height)}%
                        </div>
                        <div className="text-sm text-gray-500">Estimated body fat</div>
                      </div>
                    </div>

                    <div className="space-y-3">
                      <div className="relative h-2 bg-gradient-to-r from-green-500 via-yellow-500 to-red-500 rounded-full overflow-hidden">
                        <div
                          className="absolute w-2 h-4 bg-black -top-1 rounded-full"
                          style={{ left: `${(calculateBodyFat(weight, height) / 40) * 100}%` }}
                        />
                      </div>

                      <div className="flex justify-between text-xs text-gray-500">
                        <span>Essential Fat</span>
                        <span>Athletic</span>
                        <span>Fitness</span>
                        <span>Average</span>
                        <span>Obese</span>
                      </div>
                    </div>
                  </div>
                </Card>
              )}
            </div>
          )}

          {currentSection === 2 && (
            <div className="space-y-4">
              <Card className="p-6 rounded-[28px] border-[#0CC5BA]/10 bg-white">
                <div className="flex items-center gap-3 mb-4">
                  <div className="w-10 h-10 rounded-full bg-pink-500/10 flex items-center justify-center">
                    <Camera className="w-5 h-5 text-pink-500" />
                  </div>
                  <div>
                    <h3 className="text-lg font-bold bg-gradient-to-br from-purple-500 to-pink-500 bg-clip-text text-transparent">Progress Photos</h3>
                    <p className="text-sm text-gray-500">Visual tracking of your journey</p>
                  </div>
                </div>
                
                <div className="space-y-4">
                  <div className="flex gap-2">
                    <Button 
                      className="flex-1 bg-gradient-to-r from-purple-500 to-pink-500 text-white hover:opacity-90"
                      onClick={handleCameraOpen}
                    >
                      <Camera className="w-4 h-4 mr-2" />
                      Take Photo
                    </Button>
                    <Button 
                      className="flex-1 bg-white border border-purple-500 text-purple-500 hover:bg-purple-50"
                      onClick={() => document.getElementById('photo-upload')?.click()}
                    >
                      <Upload className="w-4 h-4 mr-2" />
                      Upload Photo
                    </Button>
                    <input
                      id="photo-upload"
                      type="file"
                      accept="image/*"
                      className="hidden"
                      onChange={handlePhotoUpload}
                    />
                  </div>
                  
                  <div className="grid grid-cols-3 gap-3 mt-4">
                    {/* Latest Photo */}
                    <div 
                      className="cursor-pointer"
                      onClick={() => {
                        const latestPhoto = photos.find(p => p.type === 'latest');
                        if (latestPhoto?.photoUrl) handlePhotoClick(latestPhoto.photoUrl);
                      }}
                    >
                      <div className="aspect-[3/4] bg-gray-100 rounded-lg overflow-hidden relative group">
                        {photos.find(p => p.type === 'latest') ? (
                          <>
                            <img
                              src={photos.find(p => p.type === 'latest')?.photoUrl}
                              alt="Latest Photo"
                              className="w-full h-full object-cover"
                            />
                            <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                              <Clock className="w-6 h-6 text-white" />
                            </div>
                          </>
                        ) : (
                          <div className="w-full h-full flex items-center justify-center">
                            <Camera className="w-8 h-8 text-gray-400" />
                          </div>
                        )}
                      </div>
                      <p className="text-xs text-center text-gray-600 mt-1">Latest Photo</p>
                    </div>
                    
                    {/* Favorite Photo */}
                    <div 
                      className="cursor-pointer"
                      onClick={() => {
                        const favoritePhoto = photos.find(p => p.type === 'favorite');
                        if (favoritePhoto?.photoUrl) handlePhotoClick(favoritePhoto.photoUrl);
                      }}
                    >
                      <div className="aspect-[3/4] bg-gray-100 rounded-lg overflow-hidden relative group">
                        {photos.find(p => p.type === 'favorite') ? (
                          <>
                            <img
                              src={photos.find(p => p.type === 'favorite')?.photoUrl}
                              alt="Favorite Photo"
                              className="w-full h-full object-cover"
                            />
                            <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                              <Heart className="w-6 h-6 text-white" />
                            </div>
                          </>
                        ) : (
                          <div className="w-full h-full flex items-center justify-center">
                            <Camera className="w-8 h-8 text-gray-400" />
                          </div>
                        )}
                      </div>
                      <p className="text-xs text-center text-gray-600 mt-1">Favorite Photo</p>
                    </div>
                    
                    {/* First Photo */}
                    <div 
                      className="cursor-pointer"
                      onClick={() => {
                        const firstUploadedPhoto = [...photos].sort((a, b) => a.id - b.id)[0];
                        if (firstUploadedPhoto?.photoUrl) handlePhotoClick(firstUploadedPhoto.photoUrl);
                      }}
                    >
                      <div className="aspect-[3/4] bg-gray-100 rounded-lg overflow-hidden relative group">
                        {photos.length > 0 ? (
                          <>
                            <img
                              src={[...photos].sort((a, b) => a.id - b.id)[0]?.photoUrl}
                              alt="First Photo"
                              className="w-full h-full object-cover"
                            />
                            <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                              <Star className="w-6 h-6 text-white" />
                            </div>
                          </>
                        ) : (
                          <div className="w-full h-full flex items-center justify-center">
                            <Camera className="w-8 h-8 text-gray-400" />
                          </div>
                        )}
                      </div>
                      <p className="text-xs text-center text-gray-600 mt-1">First Photo</p>
                    </div>
                  </div>
                  
                  <Button
                    className="w-full mt-4 bg-white border border-pink-500 text-pink-500 hover:bg-pink-50"
                    onClick={() => setIsGalleryOpen(true)}
                  >
                    View All Photos
                  </Button>
                </div>
              </Card>
            </div>
          )}

          {currentSection === 3 && (
            <div className="space-y-4">
              <Card className="p-6 rounded-[28px] border-[#0CC5BA]/10 bg-white">
                <div className="flex items-center gap-3 mb-4">
                  <div className="w-10 h-10 rounded-full bg-orange-500/10 flex items-center justify-center">
                    <Trophy className="w-5 h-5 text-orange-500" />
                  </div>
                  <div>
                    <h3 className="text-lg font-bold bg-gradient-to-br from-amber-500 to-orange-500 bg-clip-text text-transparent">Streak & XP</h3>
                    <p className="text-sm text-gray-500">Your progress achievements</p>
                  </div>
                </div>
                
                <div className="space-y-6">
                  <div className="flex items-center gap-5">
                    <div className="w-16 h-16 rounded-full bg-gradient-to-br from-amber-500 to-orange-500 text-white flex items-center justify-center text-xl font-bold">
                      {level}
                    </div>
                    <div>
                      <div className="text-sm text-gray-500">Your Level</div>
                      <div className="flex items-center gap-2">
                        <span className="font-bold text-gray-800">{streakData.xp} XP</span>
                        <span className="text-gray-400">/ {streakData.xpNeeded} XP</span>
                      </div>
                      <div className="w-full bg-gray-100 h-2 rounded-full mt-1 overflow-hidden">
                        <div 
                          className="h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded-full transition-all"
                          style={{ width: `${(streakData.xp / streakData.xpNeeded) * 100}%` }}
                        />
                      </div>
                    </div>
                  </div>
                  
                  <div className="flex gap-4">
                    <div className="flex-1 bg-gray-50 p-4 rounded-xl">
                      <div className="text-amber-500 text-xl font-bold">{streakData.currentStreak}</div>
                      <div className="text-gray-500 text-sm">Current Streak</div>
                    </div>
                    <div className="flex-1 bg-gray-50 p-4 rounded-xl">
                      <div className="text-orange-500 text-xl font-bold">{streakData.longestStreak}</div>
                      <div className="text-gray-500 text-sm">Longest Streak</div>
                    </div>
                  </div>
                  
                  <div className="bg-amber-50 p-4 rounded-xl border border-amber-100">
                    <div className="flex items-center gap-2">
                      <svg className="w-5 h-5 text-amber-500" viewBox="0 0 20 20" fill="currentColor">
                        <path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clipRule="evenodd" />
                      </svg>
                      <div className="font-medium text-amber-800">Achievements Unlocked</div>
                    </div>
                    <div className="mt-2 space-y-2">
                      <div className="flex items-center gap-2">
                        <div className="w-2 h-2 rounded-full bg-amber-500" />
                        <span className="text-sm text-gray-600">Consistent Logger (7+ days)</span>
                      </div>
                      {streakData.currentStreak >= 7 && (
                        <div className="flex items-center gap-2">
                          <div className="w-2 h-2 rounded-full bg-amber-500" />
                          <span className="text-sm text-gray-600">Weekly Warrior (7 day streak)</span>
                        </div>
                      )}
                      {streakData.currentStreak >= 30 && (
                        <div className="flex items-center gap-2">
                          <div className="w-2 h-2 rounded-full bg-amber-500" />
                          <span className="text-sm text-gray-600">Monthly Master (30 day streak)</span>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </Card>
            </div>
          )}
        </motion.div>

        {/* Navigation buttons */}
        <div className="flex justify-between mt-8">
          <Button 
            variant="outline" 
            onClick={goToPrevious}
            disabled={currentSection === 0}
            className={currentSection === 0 ? "opacity-50" : ""}
          >
            <ChevronLeft className="w-4 h-4 mr-2" />
            Previous
          </Button>
          
          <Button 
            onClick={goToNext}
            disabled={currentSection === progressSections.length - 1}
            className={`bg-[#0CC5BA] hover:bg-[#0CC5BA]/90 text-white ${currentSection === progressSections.length - 1 ? "opacity-50" : ""}`}
          >
            Next
            <ChevronRight className="w-4 h-4 ml-2" />
          </Button>
        </div>
      </div>

      {/* Dialogs and Popups */}
      <Dialog open={isGalleryOpen} onOpenChange={setIsGalleryOpen}>
        <DialogContent className="max-w-4xl w-full h-[80vh] overflow-y-auto">
          <DialogHeader>
            <DialogTitle>Photo Gallery</DialogTitle>
          </DialogHeader>
          <div className="grid grid-cols-2 md:grid-cols-3 gap-4 p-4">
            {photos.map((photo, index) => (
              <div key={index} className="relative group" onClick={(e) => e.stopPropagation()}>
                <img
                  src={photo.photoUrl}
                  alt={`Progress photo ${index + 1}`}
                  className="w-full aspect-[3/4] object-cover rounded-lg"
                  onError={(e) => {
                    console.error('Failed to load gallery photo:', e);
                    (e.target as HTMLImageElement).src = 'fallback-image-url';
                  }}
                />
                <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity">
                  <div className="absolute bottom-2 right-2 flex gap-2">
                    <Button
                      size="sm"
                      variant="secondary"
                      className="bg-white hover:bg-white/90"
                      onClick={(e) => {
                        e.stopPropagation();
                        handleSetPhotoType(photo.photoUrl, 'favorite');
                      }}
                    >
                      <Heart
                        className={`w-4 h-4 ${
                          photo.type === 'favorite'
                            ? 'text-red-500 fill-red-500'
                            : 'text-gray-500'
                        }`}
                      />
                    </Button>
                    <Button
                      size="sm"
                      variant="secondary"
                      className="bg-white hover:bg-white/90"
                      onClick={(e) => {
                        e.stopPropagation();
                        handleSetPhotoType(photo.photoUrl, 'first');
                      }}
                    >
                      <Star
                        className={`w-4 h-4 ${
                          photo.type === 'first'
                            ? 'text-yellow-500 fill-yellow-500'
                            : 'text-gray-500'
                        }`}
                      />
                    </Button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </DialogContent>
      </Dialog>

      <AnimatePresence>
        {isCameraOpen && (
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
          >
            <CameraCapture
              onClose={() => setIsCameraOpen(false)}
              onPhotoCapture={handlePhotoCapture}
            />
          </motion.div>
        )}
      </AnimatePresence>

      <Dialog open={isDialogOpen} onOpenChange={setIsDialogOpen}>
        <DialogContent className="max-w-lg">
          <DialogHeader>
            <DialogTitle>Update Weight</DialogTitle>
          </DialogHeader>
          <div className="p-4">
            <div className="flex items-center gap-4">
              <Input
                type="number"
                value={newWeight}
                onChange={(e: React.ChangeEvent<HTMLInputElement>) => setNewWeight(Number(e.target.value))}
                className="w-full"
                placeholder="Enter your weight in kg"
              />
              <div className="flex gap-2">
                <Button
                  variant="outline"
                  size="icon"
                  onClick={() => setNewWeight((prev: number) => prev - 0.1)}
                >
                  <ChevronDown className="h-4 w-4" />
                </Button>
                <Button
                  variant="outline"
                  size="icon"
                  onClick={() => setNewWeight((prev: number) => prev + 0.1)}
                >
                  <ChevronUp className="h-4 w-4" />
                </Button>
              </div>
            </div>
            <div className="flex justify-end gap-2 mt-4">
              <Button variant="outline" onClick={() => setIsDialogOpen(false)}>
                Cancel
              </Button>
              <Button onClick={handleUpdateWeight} className="bg-[#0CC5BA] hover:bg-[#0CC5BA]/90">
                Save Weight
              </Button>
            </div>
          </div>
        </DialogContent>
      </Dialog>

      <Dialog open={isHeightDialogOpen} onOpenChange={setIsHeightDialogOpen}>
        <DialogContent className="max-w-lg">
          <DialogHeader>
            <DialogTitle>Update Height</DialogTitle>
          </DialogHeader>
          <div className="p-4">
            <div className="flex items-center gap-4">
              <Input
                type="number"
                value={height}
                onChange={(e: React.ChangeEvent<HTMLInputElement>) => setHeight(Number(e.target.value))}
                className="w-full"
                placeholder="Enter your height in cm"
              />
              <div className="flex gap-2">
                <Button
                  variant="outline"
                  size="icon"
                  onClick={() => setHeight((prev: number) => prev - 1)}
                >
                  <ChevronDown className="h-4 w-4" />
                </Button>
                <Button
                  variant="outline"
                  size="icon"
                  onClick={() => setHeight((prev: number) => prev + 1)}
                >
                  <ChevronUp className="h-4 w-4" />
                </Button>
              </div>
            </div>
            <div className="flex justify-end gap-2 mt-4">
              <Button variant="outline" onClick={() => setIsHeightDialogOpen(false)}>
                Cancel
              </Button>
              <Button onClick={handleUpdateHeight} className="bg-[#0CC5BA] hover:bg-[#0CC5BA]/90">
                Save Height
              </Button>
            </div>
          </div>
        </DialogContent>
      </Dialog>

      {renderBodyFatDialog()}
    </div>
  );
}